# Copy to .env for local development. Every variable here is required at
# boot — see packages/config, which fails fast on anything missing or
# malformed rather than defaulting silently (B0 scope: "env validation at
# boot, fail fast on missing config").

# ---- Product identity -----------------------------------------------------
# PROJECT.md: the product/codename must be read from environment, never
# hardcoded in source. "Project Atlas" is a placeholder until a commercial
# name is set.
PRODUCT_NAME="Project Atlas"

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
# API base path is fixed at /v1 by convention (09 §20) — not configurable.

# ---- Database (ADR-0023 tenancy, PostgreSQL 18) ----------------------------
# Two roles per database, matching a real deployment: DATABASE_URL (the
# schema owner, "atlas") runs migrations; DATABASE_APP_URL (the
# non-superuser "atlas_app", created by infra/postgres/init.sql) is what
# the running application actually connects as. This split matters:
# Postgres superusers bypass Row-Level Security unconditionally, so if the
# app connected as the migration owner, ADR-0023's RLS policies would do
# nothing and the isolation test would pass for the wrong reason.
DATABASE_URL="postgresql://atlas:atlas_dev_password@localhost:5432/atlas_dev?schema=public"
DATABASE_APP_URL="postgresql://atlas_app:atlas_app_dev_password@localhost:5432/atlas_dev?schema=public"

# Same split again, against the ephemeral test database — kept distinct
# from the dev database so CI and the migration/RLS integration tests
# never touch dev data.
DATABASE_URL_TEST="postgresql://atlas:atlas_dev_password@localhost:5432/atlas_test?schema=public"
DATABASE_APP_URL_TEST="postgresql://atlas_app:atlas_app_dev_password@localhost:5432/atlas_test?schema=public"

# B10: a third, even-more-restricted role — read-only on audit_events alone,
# used only by GET /v1/platform/audit's cross-school query. Never used for
# anything else; see PlatformAuditReaderService's own doc comment for why
# this must stay a separate connection from DATABASE_APP_URL (that one is
# scoped by request-time RLS; this one deliberately bypasses RLS, but for
# exactly one table, via a role-scoped grant + additive policy rather than
# BYPASSRLS).
DATABASE_AUDIT_READER_URL="postgresql://atlas_audit_reader:atlas_audit_reader_dev_password@localhost:5432/atlas_dev?schema=public"
DATABASE_AUDIT_READER_URL_TEST="postgresql://atlas_audit_reader:atlas_audit_reader_dev_password@localhost:5432/atlas_test?schema=public"

# B21: per-process Postgres connection pool size (node-postgres `max`).
# Behind the pooler (production RDS Proxy; locally PgBouncer on :6432, see
# infra/load/) this is how many *client* connections each API/worker
# process holds. Formula and measured sizing: docs/performance/capacity-plan.md.
DATABASE_POOL_MAX=10

# ---- Redis-compatible (BullMQ + idempotency store) -------------------------
REDIS_URL="redis://localhost:6379"

# ---- Sessions / cross-origin (ADR-0022) ------------------------------------
# Same-site HttpOnly cookies require a shared parent domain in production;
# locally both API and web run on localhost so this is permissive.
SESSION_COOKIE_SECRET="dev-only-change-me-dev-only-change-me"
WEB_ORIGIN="http://localhost:3000"
# Cookie Domain attribute for cross-subdomain cookies (ADR-0022). Left unset
# locally — see docs/operations/domain-plan.md. Set to the shared parent
# domain (e.g. ".atlas.app") once B23 provisions production DNS.
COOKIE_DOMAIN=

# ---- Tenant resolution (ADR-0005) -------------------------------------------
# The registrable parent domain school subdomains, the API, and the
# platform-admin host sit under. "localtest.me" is a public domain whose
# wildcard DNS record already resolves every subdomain to 127.0.0.1 — no
# local DNS setup needed to test subdomain-based tenant resolution in a
# real browser. See docs/operations/domain-plan.md.
PLATFORM_ROOT_DOMAIN="localtest.me"

# ---- Timezone default (ADR-0027) -------------------------------------------
DEFAULT_SCHOOL_TIMEZONE="Africa/Lagos"

# ---- Idempotency (ADR-0033) -------------------------------------------------
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# ---- Rate limiting (B0 scaffolding — see apps/api/src/security) -----------
# Generous global default; B1 tightens specific endpoints (e.g. login) with
# route-level @Throttle() overrides on top of this baseline.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Identity & Auth (ADR-0005, ADR-0019, ADR-0022 — B1) -------------------
SESSION_TTL_SECONDS=604800
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
# Per-(school, login_identifier) lockout — apps/api/src/modules/identity.
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_SECONDS=900

# ---- Platform, Schools & Subscriptions (ADR-0015/0016/0019 — B3) -----------
# apps/worker's subscription-expiry sweeper / platform-metrics aggregation
# tick interval, in milliseconds. Default: 6 hours.
SUBSCRIPTION_SWEEP_INTERVAL_MS=21600000

# ---- Web app (F0) -----------------------------------------------------------
# Base URL apps/web's browser-side typed API client (lib/api/client.ts)
# calls. Inlined into the client bundle at build time by Next — see
# apps/web/next.config.ts's comment on why this file needs to be loaded
# explicitly there. Not consumed by @atlas/config (server-only schema).
# Used unchanged only when the page itself has no tenant subdomain (plain
# "localhost", native dev's default) — see NEXT_PUBLIC_API_PORT below.
NEXT_PUBLIC_API_ORIGIN="http://localhost:3001"
# ---- Web app (F1) -----------------------------------------------------------
# The API's port, used by lib/api/resolve-origin.ts to derive the browser's
# API origin *dynamically* from whichever school subdomain the page is
# actually being viewed at (e.g. greenfield.localtest.me:3000 (web) →
# greenfield.localtest.me:3001 (api)) — this is what makes ADR-0005's
# Host-header tenant resolution (apps/api/src/common/subdomain.ts) work for
# a real cross-origin browser call in local dev. See docs/operations/
# domain-plan.md and frontend-roadmap.md's F1 section for the production
# topology question this local-dev mechanism deliberately leaves open for B23.
# Production sets it empty: <school>.<root> then calls <school>.api.<root>.
NEXT_PUBLIC_API_PORT="3001"

# ---- F20: web security headers + client error tracking ------------------------
# The object-storage origin the browser reads question media / logos from and
# PUTs presigned uploads to — named in the web CSP (img-src, media-src,
# connect-src). Locally: MinIO. Production: the bucket's https origin (B23).
NEXT_PUBLIC_MEDIA_ORIGIN="http://localhost:9000"
# Staging: send the CSP as Content-Security-Policy-Report-Only first
# (docs/security/web-csp-policy.md), then flip to false to enforce.
CSP_REPORT_ONLY="false"
# Browser Sentry DSN (public by design). Unset = client error tracking off.
# NEXT_PUBLIC_SENTRY_DSN=

# ---- Object storage (B4) ---------------------------------------------------
# MinIO (docker-compose service `minio`), S3-compatible. `localhost:9000` is
# correct when running api/worker natively on the host; docker-compose's own
# `api`/`worker` service definitions override this to `http://minio:9000`
# (container-to-container hostname) the same way DATABASE_URL/REDIS_URL are
# overridden there. Production talks to real AWS S3 through the identical
# @aws-sdk/client-s3 client — only these values change (B23 provisioning).
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="atlas-media-dev"
S3_ACCESS_KEY_ID="atlas_minio_root"
S3_SECRET_ACCESS_KEY="atlas_minio_dev_password"
S3_REGION="us-east-1"

# B4: apps/worker's orphan-media reporting sweep interval (ms). Default: 24h.
MEDIA_ORPHAN_SWEEP_INTERVAL_MS="86400000"

# B7: apps/worker's import staging-expiry sweep interval (ms), A-17. Default: 1h.
IMPORT_EXPIRY_SWEEP_INTERVAL_MS="3600000"

# B10: apps/worker's "students with no active enrollment" digest sweep for
# Moderator (ms). Default: 12h.
UNASSIGNED_STUDENTS_DIGEST_INTERVAL_MS="43200000"

# B12: apps/worker's Exam Control Center aggregate-refresh + stale-exam
# detection sweep (ms). Default: 5s.
EXAM_CONTROL_REFRESH_INTERVAL_MS="5000"
ANALYTICS_REFRESH_INTERVAL_MS="900000"

# B12: how long an exam may sit OPEN with no session activity before the
# Control Center flags it as stale — never auto-closed (ms). Default: 4h.
EXAM_STALENESS_THRESHOLD_MS="14400000"

# B14: apps/worker's ADR-0004 auto-submission sweep interval — the
# last-resort backstop for a fully abandoned attempt (ms). Default: 15s.
ATTEMPT_AUTO_SUBMIT_SWEEP_INTERVAL_MS="15000"

# ADR-0003: post-expiry grace window (seconds) — an integrity parameter,
# never a per-school policy. Read directly by @atlas/domain's
# attemptGraceWindowSeconds(), not apps/api's/apps/worker's validated Env
# object; declared here so a malformed value fails fast at boot instead of
# silently falling back. Default: 60s.
ATTEMPT_GRACE_WINDOW_SECONDS="60"

# ---- B20: Security hardening -------------------------------------------------
# Every value below is optional outside production. In production
# (NODE_ENV=production) the API/worker refuse to boot unless:
#   SESSION_COOKIE_SECRET, CSRF_SECRET and MFA_ENCRYPTION_KEY are ≥32 random
#   chars and not dev defaults; CSRF_SECRET differs from the session secret;
#   every DATABASE_* URL carries sslmode=require (or verify-ca/verify-full);
#   REDIS_URL is rediss://; COOKIE_DOMAIN is set. See packages/config.
# CSRF_SECRET=
# MFA_ENCRYPTION_KEY=
# F20: derives each exam's media pre-cache key (ADR-0021 amendment). Required
# in production (≥32 random chars, not reused from another secret); rotate
# only between exam windows — in-flight pre-caches then fall back to the
# Start-time download.
# MEDIA_PRECACHE_SECRET=
# Software Admin MFA enforcement — on: an unenrolled admin is confined to the
# enrolment routes, and the web app routes them straight into enrolment (F20).
PLATFORM_MFA_REQUIRED="true"
# Software Admin session lifetime: 8h absolute, 30 min idle.
PLATFORM_SESSION_TTL_SECONDS="28800"
PLATFORM_SESSION_IDLE_TIMEOUT_SECONDS="1800"

# Reverse-proxy hops to trust for the client IP. 0 locally; 1 behind the ALB.
TRUST_PROXY_HOPS="0"

# Per-class rate limits (per minute) — see apps/api/src/security/rate-limit.ts.
RATE_LIMIT_ANSWER_MAX="600"
RATE_LIMIT_HEAVY_MAX="30"
RATE_LIMIT_AUTH_IDENTIFIER_MAX="10"
RATE_LIMIT_AUTH_IP_MAX="120"

# ---- B20: Observability (08 §18, 09 §35) ---------------------------------------
LOG_LEVEL="info"
# Unset = no export (logs still go to stdout as JSON).
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# SENTRY_DSN=
# RELEASE_VERSION=

# ---- B20: Exam Health Monitor + alerts (09 §37) --------------------------------
# Comma-separated operator addresses for operational/security alerts.
OPS_ALERT_EMAILS=""
# B23 email transport (ADR-0019): "console" here; production requires "ses"
# (AWS, sender on the domain's verified SES identity, set by infra/cdk) or
# "smtp" (the single-server pilot, docs/operations/vps-pilot.md).
NOTIFICATION_TRANSPORT="console"
SES_FROM_ADDRESS=""
SES_REGION=""
# SMTP: port 465 is implicit TLS; any other port must offer STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_ADDRESS=""
EXAM_HEALTH_INTERVAL_MS="60000"
EXAM_HEALTH_WINDOW_MINUTES="5"
EXAM_HEALTH_ANSWER_SUCCESS_MIN="0.95"
EXAM_HEALTH_ANSWER_MIN_SAMPLE="50"

# ---- B20: Retention sweep (ADR-0028 amended) -----------------------------------
RETENTION_SWEEP_INTERVAL_MS="86400000"
