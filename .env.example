# Copy to .env for local development. Every variable here is required at
# boot — see packages/config, which fails fast on anything missing or
# malformed rather than defaulting silently (B0 scope: "env validation at
# boot, fail fast on missing config").

# ---- Product identity -----------------------------------------------------
# PROJECT.md: the product/codename must be read from environment, never
# hardcoded in source. "Project Atlas" is a placeholder until a commercial
# name is set.
PRODUCT_NAME="Project Atlas"

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
# API base path is fixed at /v1 by convention (09 §20) — not configurable.

# ---- Database (ADR-0023 tenancy, PostgreSQL 18) ----------------------------
# Two roles per database, matching a real deployment: DATABASE_URL (the
# schema owner, "atlas") runs migrations; DATABASE_APP_URL (the
# non-superuser "atlas_app", created by infra/postgres/init.sql) is what
# the running application actually connects as. This split matters:
# Postgres superusers bypass Row-Level Security unconditionally, so if the
# app connected as the migration owner, ADR-0023's RLS policies would do
# nothing and the isolation test would pass for the wrong reason.
DATABASE_URL="postgresql://atlas:atlas_dev_password@localhost:5432/atlas_dev?schema=public"
DATABASE_APP_URL="postgresql://atlas_app:atlas_app_dev_password@localhost:5432/atlas_dev?schema=public"

# Same split again, against the ephemeral test database — kept distinct
# from the dev database so CI and the migration/RLS integration tests
# never touch dev data.
DATABASE_URL_TEST="postgresql://atlas:atlas_dev_password@localhost:5432/atlas_test?schema=public"
DATABASE_APP_URL_TEST="postgresql://atlas_app:atlas_app_dev_password@localhost:5432/atlas_test?schema=public"

# ---- Redis-compatible (BullMQ + idempotency store) -------------------------
REDIS_URL="redis://localhost:6379"

# ---- Sessions / cross-origin (ADR-0022) ------------------------------------
# Same-site HttpOnly cookies require a shared parent domain in production;
# locally both API and web run on localhost so this is permissive.
SESSION_COOKIE_SECRET="dev-only-change-me-dev-only-change-me"
WEB_ORIGIN="http://localhost:3000"
# Cookie Domain attribute for cross-subdomain cookies (ADR-0022). Left unset
# locally — see docs/operations/domain-plan.md. Set to the shared parent
# domain (e.g. ".atlas.app") once B23 provisions production DNS.
COOKIE_DOMAIN=

# ---- Tenant resolution (ADR-0005) -------------------------------------------
# The registrable parent domain school subdomains, the API, and the
# platform-admin host sit under. "localtest.me" is a public domain whose
# wildcard DNS record already resolves every subdomain to 127.0.0.1 — no
# local DNS setup needed to test subdomain-based tenant resolution in a
# real browser. See docs/operations/domain-plan.md.
PLATFORM_ROOT_DOMAIN="localtest.me"

# ---- Timezone default (ADR-0027) -------------------------------------------
DEFAULT_SCHOOL_TIMEZONE="Africa/Lagos"

# ---- Idempotency (ADR-0033) -------------------------------------------------
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# ---- Rate limiting (B0 scaffolding — see apps/api/src/security) -----------
# Generous global default; B1 tightens specific endpoints (e.g. login) with
# route-level @Throttle() overrides on top of this baseline.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Object storage (stubbed in B0; wired in B4) ---------------------------
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="eu-west-1"
