# syntax=docker/dockerfile:1
# Local development image, shared by apps/api and apps/worker (docker-compose
# picks the process via `command:`, not a separate image each). NOT the
# production image — B0 defers production packaging to B23 ("Production
# infrastructure provisioning (moves to B23). B0 delivers local and CI
# environments only.").
#
# Single stage, whole-repo build: simplicity over image size for a local dev
# container. Node 24 LTS per CLAUDE.md's technology baseline (ADR-0031).
FROM node:26-alpine

# B20: pnpm is activated into a shared, non-root-readable location so the
# unprivileged runtime user below never needs to download it at start-up.
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable && corepack prepare pnpm@11.27.1 --activate

# The base image's bundled npm is never used here (pnpm via corepack does
# every install and script), and its own vendored dependencies are where
# the image scan's HIGH findings live (brace-expansion, ip-address, tar,
# undici — 2026-10-02). Removing the unused tool removes them.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

# B20 container hardening: never run as root. Everything from here on runs
# as the official image's `node` user (uid 1000), so the repo is owned by it
# as it is written. (A trailing `chown -R` instead duplicated every file,
# node_modules included, into a second layer — roughly doubling the image
# and filling the CI runner's disk, 2026-10-02.) CI builds this image and
# Trivy-scans it (HIGH/CRITICAL blocks the merge); the B23 production image
# inherits the same scan job.
RUN mkdir /repo && chown node:node /repo && chown -R node:node /opt/corepack
WORKDIR /repo
USER node

# Full monorepo context — pnpm's workspace install needs every
# package.json present to resolve the lockfile correctly, and copying them
# individually is more fragile than it's worth for a dev-only image.
COPY --chown=node:node . .

# BuildKit cache mount: persists pnpm's content-addressable store across
# builds (and across retries of this same build) instead of redownloading
# every package from the registry each time — this registry has shown
# transient timeouts on a cold install.
RUN --mount=type=cache,target=/home/node/.local/share/pnpm/store,uid=1000,gid=1000 \
    pnpm install --frozen-lockfile

# A genuine ordering cycle between two things that each need the other
# built first, broken by building @atlas/config alone before either side:
#   - `pnpm db:generate` runs `prisma generate`, which loads
#     packages/db/prisma.config.ts — that imports @atlas/config, which
#     (like every packages/* workspace package) now builds to real dist/
#     output, so it must exist before this step runs at all.
#   - packages/db's own build (tsc) needs the Prisma Client's generated
#     types to exist first (`../generated/client`), so db:generate must
#     run before `pnpm build` gets to packages/db.
RUN pnpm --filter @atlas/config run build
RUN pnpm db:generate
# @atlas/domain and @atlas/contracts build to real dist/ output too (see
# their package.json) — apps/api and apps/worker resolve every
# packages/* dependency through dist, not source (see CLAUDE.md's
# 2026-08-25 change-log entry for why). Scoped to just these two apps
# (turbo pulls in their workspace dependencies automatically) — apps/web
# isn't part of this image (see docker-compose.yml; it isn't
# containerized in B0) and building it here too would be dead weight at
# best.
RUN pnpm turbo run build --filter=@atlas/api --filter=@atlas/worker

# docker-compose.yml sets `command:` per service to select api or worker.
