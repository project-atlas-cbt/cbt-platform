{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_liveness",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Liveness probe — the process is up.",
        "tags": ["health"]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_readiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Readiness probe — database, Redis, and object storage are reachable.",
        "tags": ["health"]
      }
    },
    "/tenant/resolve": {
      "get": {
        "operationId": "IdentityController_resolveTenant",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Resolve the current subdomain's school for pre-login branding (ADR-0005), plus a CSRF token.",
        "tags": ["identity"]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "IdentityController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Authenticate within the resolved tenant (ADR-0005).",
        "tags": ["identity"]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "IdentityController_logout",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Revoke the current session.",
        "tags": ["identity"]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "IdentityController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Rotate the current session (ADR-0022).",
        "tags": ["identity"]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "IdentityController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Current user, membership, and roles — read live from the database.",
        "tags": ["identity"]
      }
    },
    "/auth/password/change": {
      "post": {
        "operationId": "IdentityController_changePassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChangeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Authenticated password change — clears any forced-change state.",
        "tags": ["identity"]
      }
    },
    "/auth/password/reset/request": {
      "post": {
        "operationId": "IdentityController_requestPasswordReset",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Initiate a staff password reset (ADR-0019 — students have no email).",
        "tags": ["identity"]
      }
    },
    "/auth/password/reset/confirm": {
      "post": {
        "operationId": "IdentityController_confirmPasswordReset",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetConfirmDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Complete a password reset with a single-use token.",
        "tags": ["identity"]
      }
    }
  },
  "info": {
    "title": "Project Atlas API",
    "description": "Multi-tenant CBT platform API. Error envelope and idempotency contract: ADR-0033.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "components": {
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Login identifier — username or school-issued student ID."
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["identifier", "password"]
      },
      "PasswordChangeDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 10
          }
        },
        "required": ["newPassword"]
      },
      "PasswordResetRequestDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "The staff login identifier to send a reset link for. Students have no email — see A-02."
          }
        },
        "required": ["identifier"]
      },
      "PasswordResetConfirmDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 10
          }
        },
        "required": ["token", "newPassword"]
      },
      "ErrorEnvelopeErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable, machine-readable code. Clients branch on this, never on `message`.",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "description": "Human-readable — for logs/debugging, not client branching."
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether retrying the same request (with the same Idempotency-Key, if it had one) could succeed. F13's offline sync queue decides retry-vs-drop from this."
          },
          "correlationId": {
            "type": "string",
            "description": "Correlates this response to server-side logs."
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Present for some error codes — e.g. VALIDATION_ERROR's failing fields."
          }
        },
        "required": ["code", "message", "retryable", "correlationId"]
      },
      "ErrorEnvelopeDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorEnvelopeErrorDto"
          }
        },
        "required": ["error"]
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "ADR-0033: a client-generated UUIDv7, one per logical mutating operation (POST/PUT/PATCH/DELETE). A replay of the same key returns the original response unchanged; the same key with a different request body is rejected with IDEMPOTENCY_KEY_REPLAY_MISMATCH (409), never a silent overwrite. Optional per endpoint — GET/HEAD ignore it entirely.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
