  "info": {
    "title": "Project Atlas API",
    "description": "Multi-tenant CBT platform API. Error envelope and idempotency contract: ADR-0033.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "components": {
    "schemas": {
      "EffectivePermissionDto": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "string",
            "description": "PERMISSION_TABLE row id (@atlas/domain)."
          },
          "section": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "description": "Human-readable label, traceable to docs/02-roles-permissions.md."
          },
          "action": {
            "type": "string",
            "enum": ["CREATE", "READ", "UPDATE", "DELETE", "EXECUTE"]
          },
          "scope": {
            "type": "string",
            "enum": ["NONE", "SELF", "OWNED", "ASSIGNED", "DEPARTMENT", "SCHOOL", "PLATFORM"],
            "description": "Absent when this capability is only reachable via break-glass (breakGlass=true)."
          },
          "breakGlass": {
            "type": "boolean",
            "description": "ADR-0012: reachable only through the audited break-glass path, never an ordinary grant."
          }
        },
        "required": ["resource", "section", "label", "action"]
      },
      "MePermissionsResponseDto": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["SOFTWARE_ADMIN", "SCHOOL_ADMIN", "MODERATOR", "HOD", "TEACHER", "STUDENT"]
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EffectivePermissionDto"
            }
          }
        },
        "required": ["roles", "permissions"]
      },
      "TenantResolveSchoolDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "subdomain": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone (ADR-0027)."
          }
        },
        "required": ["name", "subdomain", "timezone"]
      },
      "TenantResolveResponseDto": {
        "type": "object",
        "properties": {
          "school": {
            "nullable": true,
            "description": "null when the request resolved no school (platform host, unrecognised subdomain, or the bare root domain).",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/TenantResolveSchoolDto"
              }
            ]
          },
          "csrfToken": {
            "type": "string",
            "description": "ADR-0022's double-submit CSRF token."
          }
        },
        "required": ["school", "csrfToken"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Login identifier — username or school-issued student ID."
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["identifier", "password"]
      },
      "StatusResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"],
            "example": "ok"
          }
        },
        "required": ["status"]
      },
      "MeUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "UserStatus (06 §7) — e.g. ACTIVE, SUSPENDED."
          }
        },
        "required": ["id", "firstName", "lastName", "displayName", "status"]
      },
      "MeMembershipDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "loginIdentifier": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "SchoolMembership.status (07 §5.2)."
          }
        },
        "required": ["id", "loginIdentifier", "status"]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/MeUserDto"
          },
          "membership": {
            "$ref": "#/components/schemas/MeMembershipDto"
          },
          "roles": {
            "type": "array",
            "description": "Active RoleAssignment.role values for this membership (02).",
            "items": {
              "type": "string",
              "enum": ["SOFTWARE_ADMIN", "SCHOOL_ADMIN", "MODERATOR", "HOD", "TEACHER", "STUDENT"]
            }
          },
          "effectiveSchoolId": {
            "type": "string"
          }
        },
        "required": ["user", "membership", "roles", "effectiveSchoolId"]
      },
      "PasswordChangeDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 10
          }
        },
        "required": ["newPassword"]
      },
      "PasswordResetRequestDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "The staff login identifier to send a reset link for. Students have no email — see A-02."
          }
        },
        "required": ["identifier"]
      },
      "PasswordResetConfirmDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 10
          }
        },
        "required": ["token", "newPassword"]
      },
      "PlatformLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Software Admin's account email."
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["email", "password"]
      },
      "PlatformMeUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "UserStatus (06 §7)."
          }
        },
        "required": ["id", "firstName", "lastName", "displayName", "status"]
      },
      "PlatformMeResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/PlatformMeUserDto"
          },
          "roles": {
            "type": "array",
            "description": "Active PlatformRoleAssignment.role values (02).",
            "items": {
              "type": "string",
