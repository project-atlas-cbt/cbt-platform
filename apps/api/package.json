{
  "name": "@atlas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "openapi:emit": "nest build && node dist/openapi/emit.js",
    "spike": "tsx src/spike/run-spike.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rimraf dist",
    "ops:redact-subject": "tsx src/ops/redact-subject.ts",
    "ops:mfa-reset": "tsx src/ops/mfa-reset.ts",
    "ops:create-software-admin": "tsx src/ops/create-software-admin.ts",
    "ops:replay-jobs": "tsx src/ops/replay-jobs.ts",
    "ops:restore-verify": "tsx src/ops/restore-verify.ts",
    "ops:anonymise-copy": "tsx src/ops/anonymise-copy-cli.ts",
    "ops:attempts-affected": "tsx src/ops/attempts-affected-cli.ts",
    "ops:backfill-subject-registrations": "tsx src/ops/backfill-subject-registrations.ts",
    "ops:fix-name-order": "tsx src/ops/fix-name-order.ts",
    "test:security": "vitest run --config vitest.security.config.ts"
  },
  "dependencies": {
    "@atlas/config": "workspace:*",
    "@atlas/db": "workspace:*",
    "@atlas/domain": "workspace:*",
    "@atlas/notifications": "workspace:*",
    "@atlas/observability": "workspace:*",
    "@atlas/validation": "workspace:*",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/csrf": "^8.1.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.1",
    "bullmq": "^6.3.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^2.0.1",
    "cookie-signature": "^1.2.2",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "fastify": "5.12.5",
    "file-type": "^21.0.0",
    "image-size": "^2.0.4",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.14",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/cookie-signature": "^1.1.2",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
