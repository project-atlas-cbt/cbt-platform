{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // Shared config files every package's tsconfig/eslint config extends —
  // without this, a change to one of these doesn't invalidate any
  // package's turbo cache, since turbo's default hashing only tracks
  // files inside each package's own directory.
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.mjs",
    ".prettierrc.json",
    "pnpm-workspace.yaml"
  ],
  // Turbo 2.x defaults to STRICT env mode: a task only sees variables declared
  // here (or in a task's own `env`/`passThroughEnv`), plus a small built-in
  // list. Without this, `pnpm test:integration` -> `turbo run test:integration`
  // runs the test processes with the DB/Redis URLs filtered out, and every
  // integration file dies at import with "DATABASE_APP_URL is not set" — even
  // though CI's job env sets it. Invisible locally, because packages/config's
  // loadRootEnv() reads the root .env file; CI has no .env by design.
  //
  // passThrough (not `globalEnv`) deliberately: these are per-environment
  // connection strings and secrets, and must not feed Turbo's cache-key hash.
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_APP_URL",
    "DATABASE_AUDIT_READER_URL",
    "DATABASE_URL_TEST",
    "DATABASE_APP_URL_TEST",
    "DATABASE_AUDIT_READER_URL_TEST",
    "REDIS_URL",
    "PRODUCT_NAME",
    "SESSION_COOKIE_SECRET",
    "WEB_ORIGIN",
    "PLATFORM_ROOT_DOMAIN",
    "COOKIE_DOMAIN",
    "PRISMA_USER_CONSENT_FOR_DANGEROUS_AI_ACTION",
    "NODE_ENV",
    "CI",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_REGION",
    // B20 security hardening / observability
    "CSRF_SECRET",
    "MFA_ENCRYPTION_KEY",
    "PLATFORM_MFA_REQUIRED",
    "TRUST_PROXY_HOPS",
    "LOG_LEVEL",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "SENTRY_DSN",
    "RELEASE_VERSION",
    "OPS_ALERT_EMAILS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    // B20: endpoint-wide security suites — their own task/CI job.
    "test:security": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "generate": {
      "cache": false,
      "outputs": ["generated/**", "src/generated/**"]
    },
    "spike": {
      "cache": false,
      "dependsOn": ["^build"]
    }
  }
}
