{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // Shared config files every package's tsconfig/eslint config extends —
  // without this, a change to one of these doesn't invalidate any
  // package's turbo cache, since turbo's default hashing only tracks
  // files inside each package's own directory.
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.mjs",
    ".prettierrc.json",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "generate": {
      "cache": false,
      "outputs": ["generated/**", "src/generated/**"]
    },
    "spike": {
      "cache": false,
      "dependsOn": ["^build"]
    }
  }
}
