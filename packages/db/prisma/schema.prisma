// Project Atlas — Prisma schema.
//
// B0 delivered the tenancy CONVENTION (School + the TenancyProbe scaffolding
// that proved it). B1 delivers the first real domain — Identity & Auth
// (docs/roadmaps/backend-roadmap.md "B1") — and, per TenancyProbe's own doc
// comment, drops the scaffolding now that a real school-owned table exists
// to carry the isolation-test suite instead (see
// tests/tenancy/rls.integration.test.ts, rewritten against
// SchoolMembership).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// This custom `output` sits outside node_modules, in our own source tree —
// so the generated client's CJS runtime bundle (loaded via createRequire
// even though this package is "type": "module") resolves its own
// dependencies by climbing node_modules from THAT location, not from
// wherever @prisma/client itself lives. Under pnpm's strict, non-hoisted
// linking, that climb only reaches what packages/db declares directly —
// hence @prisma/client-runtime-utils is listed as an explicit dependency
// in package.json even though it's really a dependency of @prisma/client.
// Symptom if this drifts out of sync on a future @prisma/client bump:
// `Cannot find module '@prisma/client-runtime-utils'` at app boot (only
// via plain `node`, not `tsx` — see apps/api's `start` script).

// Prisma 7: the connection URL is no longer set here. Migrate reads it from
// prisma.config.ts's `datasource.url`; PrismaClient at runtime takes a
// driver adapter instead (see src/client.ts) — both resolve DATABASE_URL
// via @atlas/config's loadRootEnv(), never a URL hardcoded in schema.
datasource db {
  provider = "postgresql"
}

/// Tenant root. Full school lifecycle fields (status, subscription, address)
/// arrive in B3; branding fields (logo, primary colour, derived palette) in
/// B4 — this model is extended, not replaced, by both.
///
/// B3 note: "School identifier" (05 §3.2's required, generated, unique
/// creation field) IS `subdomain` — ADR-0005 already froze it as the unique
/// tenant-resolution key derived from the school's name/code, so B3 does not
/// add a redundant separate `school_code` column despite 07 §4.1 listing one.
model School {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  subdomain String   @unique @db.VarChar(63)
  timezone  String   @default("Africa/Lagos")

  // --- B3: school profile fields (07 §4.1), set post-activation via
  // PATCH /v1/school/profile (03 §4 Step 1) — not required at platform
  // creation (05 §3.2's narrower required-field list). Logo/primary colour
  // stay out — B4's own doc comment above already reserves them.
  shortName    String? @map("short_name") @db.VarChar(32)
  contactEmail String? @map("contact_email") @db.VarChar(320)
  contactPhone String? @map("contact_phone") @db.VarChar(32)
  address      String?

  /// Derived, cached access-gate label (ADR-0016) — recomputed by
  /// @atlas/domain's resolveSchoolStatus on every subscription/activation/
  /// platform-action mutation (AccessGateService). Never set independently
  /// outside that recomputation; never read directly by a guard — every
  /// guard calls AccessGateService instead (ADR-0016: "no guard reads either
  /// field directly").
  status SchoolStatus @default(PROVISIONAL)
  /// Explicit Software-Admin platform action (suspend/deactivate),
  /// independent of and taking precedence over the subscription-derived
  /// state (ADR-0016 precedence: DEACTIVATED > SUSPENDED > subscription-
  /// derived). Null = no override — the subscription-derived status governs.
  platformOverride SchoolPlatformOverride? @map("platform_override")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         SchoolMembership[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]
  subscriptions       Subscription[]
  activationGrants    ActivationGrant[]

  @@map("schools")
}

/// Persisted School.status label (07 §4.1) — see School.status's own doc
/// comment for the derivation rule (@atlas/domain's resolveSchoolStatus).
enum SchoolStatus {
  PROVISIONAL
  ACTIVE
  SUSPENDED
  EXPIRED
  DEACTIVATED
}

/// The two platform actions Software Admin can set directly on School.status
/// (ADR-0016). A separate enum from SchoolStatus (not a nullable subset of
/// it) so no other SchoolStatus value can ever be assigned to this column by
/// mistake — only these two platform actions are valid overrides.
enum SchoolPlatformOverride {
  SUSPENDED
  DEACTIVATED
}

// ---------------------------------------------------------------------------
// Identity & Access domain (07 §5, 06 §6-12) — B1.
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// 07 §5.1 lists "authentication state" and "account status" as two
/// distinct User attributes; this enum is the former. Kept separate from
/// UserStatus (the latter) per audit C-14's status-precedence resolution —
/// a SUSPENDED user and a user who merely hasn't set a password yet are
/// different facts and must not share one field.
enum CredentialState {
  /// Invited, no password set — must arrive via the initial-credential flow
  /// (staff: invitation link; student: system-generated password) before
  /// any authenticated route works.
  MUST_SET_PASSWORD
  /// A password exists but is a system-generated temporary one (student
  /// initial password) — every authenticated route except
  /// POST /auth/password/change is blocked until it's changed (B1 DoD
  /// item 8: "cannot be bypassed by calling any other endpoint").
  MUST_CHANGE_PASSWORD
  OK
}

enum MembershipStatus {
  PENDING
  ACTIVE
  INACTIVE
  ENDED
}

/// Mirrors @atlas/domain's ROLES (packages/domain/src/roles.ts) exactly —
/// Prisma enums can't import a TS const, so the two are hand-kept in sync.
/// roles.test.ts and this schema's own lint (scripts/lint-schema-tenancy.mjs
/// doesn't check this, but B2's authorization engine — the next consumer —
/// will fail loudly on drift) are the guardrails.
enum Role {
  SOFTWARE_ADMIN
  SCHOOL_ADMIN
  MODERATOR
  HOD
  TEACHER
  STUDENT
}

enum RoleAssignmentStatus {
  ACTIVE
  ENDED
}

/// Academic standing only (audit C-14's resolution) — never consulted by
/// login itself, only by scope/eligibility logic later phases build.
enum StudentProfileStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN
  ARCHIVED
}

enum EmploymentStatus {
  ACTIVE
  ENDED
}

/// Represents a person's authentication/account identity (06 §6). Deliberately
/// tenant-independent — no school_id — because one physical person may hold
/// SchoolMembership at more than one school (06 §7/§9's own example); RLS
/// therefore does not apply here (nothing to scope it by), and this model is
/// exempted in scripts/lint-schema-tenancy.mjs alongside School.
///
/// `login_identifier` deliberately does NOT live here despite 07 §5.1 listing
/// it as a User attribute: ADR-0005 requires it unique *per school*, not
/// globally (so two schools can each have student "ST001"), which only
/// SchoolMembership — the entity that already represents "this person's
/// relationship with this school" (07 §5.2) — can express without giving
/// User a school_id and breaking the multi-school membership model this
/// same file documents two sections later. See SchoolMembership.loginIdentifier.
model User {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firstName       String          @map("first_name")
  lastName        String          @map("last_name")
  displayName     String          @map("display_name")
  /// ADR-0019: staff-facing flows (password reset, invitations) need an
  /// email address to deliver to; students have none by design (no
  /// institutional email — see ADR-0019's Context) and this stays null for
  /// them. Not an auth identifier — see SchoolMembership.loginIdentifier for
  /// that. Not required to be globally unique: no spec mandates it, and a
  /// person could plausibly share a personal address across two accounts.
  email           String?         @db.VarChar(320)
  /// Argon2id hash (09 §24). Null until the first credential is set —
  /// MUST_SET_PASSWORD accounts have no hash yet.
  passwordHash    String?         @map("password_hash")
  credentialState CredentialState @default(MUST_SET_PASSWORD) @map("credential_state")
  status          UserStatus      @default(INVITED)
  lastLoginAt     DateTime?       @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships             SchoolMembership[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  platformRoleAssignments PlatformRoleAssignment[]
  platformSessions        PlatformSession[]
  issuedActivationGrants  ActivationGrant[]

  @@map("users")
}

/// A user's relationship with a school (07 §5.2). School-owned — carries
/// the tenancy convention's denormalised school_id.
model SchoolMembership {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId        String           @map("school_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  /// Per-school-unique login identifier (staff username, or school-issued
  /// student ID like "ST001") — see User's doc comment for why this lives
  /// here rather than on User. ADR-0005.
  loginIdentifier String           @map("login_identifier") @db.VarChar(64)
  status          MembershipStatus @default(PENDING)
  joinedAt        DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt          DateTime?        @map("left_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleAssignments RoleAssignment[]
  studentProfile  StudentProfile?
  teacherProfile  TeacherProfile?

  // Composite-FK target for RoleAssignment/StudentProfile/TeacherProfile,
  // matching TenancyProbe's proven (schoolId, id) pattern.
  @@unique([schoolId, id])
  @@unique([schoolId, loginIdentifier])
  @@index([schoolId])
  @@index([userId])
  @@map("school_memberships")
}

/// A role within a school membership (07 §5.3) — a membership may hold more
/// than one (e.g. TEACHER + HOD).
model RoleAssignment {
  id            String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId      String               @map("school_id") @db.Uuid
  membershipId  String               @map("membership_id") @db.Uuid
  role          Role
  effectiveFrom DateTime             @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime?            @map("effective_to") @db.Timestamptz(6)
  status        RoleAssignmentStatus @default(ACTIVE)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership SchoolMembership @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, membershipId])
  @@map("role_assignments")
}

/// Student-specific academic identity (07 §5.4). 0..1 per membership.
model StudentProfile {
  id              String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId        String               @map("school_id") @db.Uuid
  membershipId    String               @map("membership_id") @db.Uuid
  studentId       String               @map("student_id") @db.VarChar(32)
  admissionNumber String?              @map("admission_number") @db.VarChar(32)
  status          StudentProfileStatus @default(ACTIVE)
  admissionDate   DateTime?            @map("admission_date") @db.Timestamptz(6)
  graduationDate  DateTime?            @map("graduation_date") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership SchoolMembership @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, membershipId])
  @@unique([schoolId, studentId])
  @@index([schoolId])
  @@map("student_profiles")
}

/// Teacher-specific operational identity (07 §5.5). 0..1 per membership.
model TeacherProfile {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId         String           @map("school_id") @db.Uuid
  membershipId     String           @map("membership_id") @db.Uuid
  staffId          String           @map("staff_id") @db.VarChar(32)
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  hireDate         DateTime?        @map("hire_date") @db.Timestamptz(6)
  endDate          DateTime?        @map("end_date") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership SchoolMembership @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, membershipId])
  @@unique([schoolId, staffId])
  @@index([schoolId])
  @@map("teacher_profiles")
}

/// Server-side session record (ADR-0022). The bearer cookie value is never
/// stored — only its sha256, so a database read alone can't forge a
/// session. Roles are never derived from this row; every authenticated
/// request re-reads RoleAssignment live (09 §25).
model Session {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Points at the session this one replaced via POST /auth/refresh — the
  /// old row's revokedAt is set atomically with creating this one.
  rotatedFromId String?   @unique @map("rotated_from_id") @db.Uuid
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address") @db.VarChar(64)

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedFrom Session? @relation("SessionRotation", fields: [rotatedFromId], references: [id])
  rotatedTo   Session? @relation("SessionRotation")

  @@index([schoolId])
  @@index([userId])
  @@map("sessions")
}

/// Single-use staff password-reset token (ADR-0019). Students have no email
/// and never receive one — see credential-sheet.service.ts for their path.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Authorization & Tenancy Engine (08 §10, 07 §41-42) — B2.
// ---------------------------------------------------------------------------

/// SOFTWARE_ADMIN's schema representation (2026-08-26 decision, confirmed
/// with the project owner before implementation — see CLAUDE.md's B2
/// Change Log entry). Deliberately tenant-independent, mirroring User
/// itself: a platform role has no school to be owned by, so it cannot live
/// under SchoolMembership the way RoleAssignment does. Exempted in
/// scripts/lint-schema-tenancy.mjs alongside User/School.
///
/// Only SOFTWARE_ADMIN is a real row here today (PLATFORM_ROLES in
/// @atlas/domain has exactly one member) — the `role` column reuses the
/// shared Role enum rather than a new one-member enum so a future second
/// platform role (none currently planned) would not require a schema
/// migration to the enum itself, only a new CHECK constraint entry. The
/// CHECK constraint (see this model's migration) rejects any school-role
/// value here at the database level, not just in application code.
model PlatformRoleAssignment {
  id            String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  role          Role
  effectiveFrom DateTime             @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime?            @map("effective_to") @db.Timestamptz(6)
  status        RoleAssignmentStatus @default(ACTIVE)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_role_assignments")
}

/// Minimal, real append-only audit primitive — deliberately not the full
/// B10 deliverable (07 §11.1's canonical action vocabulary, retrieval
/// endpoints, DB-enforced immutability trigger, retention policy). B2
/// needs a genuine write path now for ADR-0012's break-glass requirement
/// ("emits an elevated audit event") the same way B0 shipped a minimal
/// NotificationChannel ahead of a full B10-equivalent — B10 builds the
/// rest of the apparatus on top of this same table, not a replacement for
/// it. See apps/api's AuditService (OperationsModule).
///
/// School-owned: `schoolId` is the *affected* school (per ADR-0012, break-
/// glass events must be "visible to the target school"), not necessarily
/// the actor's own school — Software Admin has none. Writing a row here
/// for a cross-tenant break-glass action deliberately goes through
/// `withTenant(prisma, targetSchoolId, ...)`, the same controlled,
/// explicit bypass path @atlas/db's tenancy.ts already anticipated for B2.
model AuditEvent {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  actorRole   Role     @map("actor_role")
  /// Free-form for now (e.g. "BREAK_GLASS_FORCE_PASSWORD_RESET") — 07
  /// §11.1's canonical, closed vocabulary (resolving audit finding C-02) is
  /// B10 scope.
  action      String   @db.VarChar(64)
  entityType  String?  @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.Uuid
  reason      String?
  breakGlass  Boolean  @default(false) @map("break_glass")
  metadata    Json?
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, occurredAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Platform, Schools & Subscriptions (07 §4, 03 §2-3/§66-67, ADR-0012/0015/
// 0016/0019) — B3.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRING
  EXPIRED
  SUSPENDED
  CANCELLED
}

/// Commercial truth (ADR-0016) — School.status is a derived, cached label
/// computed from this plus SchoolPlatformOverride via @atlas/domain's
/// resolveSchoolStatus/resolveAccessGate, never read directly by a guard.
/// One school may have many historical Subscription rows; at most one is
/// ever PENDING/ACTIVE/EXPIRING at a time — enforced by a partial unique
/// index in this migration's hand-written SQL (Prisma's schema DSL can't
/// express a filtered/partial unique constraint).
///
/// SUSPENDED/CANCELLED exist in the enum to match 07 §4.2 exactly, but no B3
/// endpoint ever sets them — no spec'd action triggers a subscription-level
/// (as opposed to school-level, SchoolPlatformOverride) suspend/cancel.
/// @atlas/domain's resolveSchoolStatus defends against them defensively
/// (collapsing to the same restricted EXPIRED label). Recorded as
/// Candidate/Deferred in CLAUDE.md.
model Subscription {
  id        String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId  String             @map("school_id") @db.Uuid
  plan      String             @db.VarChar(64)
  startAt   DateTime           @map("start_at") @db.Timestamptz(6)
  expiresAt DateTime           @map("expires_at") @db.Timestamptz(6)
  status    SubscriptionStatus @default(PENDING)
  /// Highest pre-expiry warning threshold (days before expiresAt) already
  /// dispatched by the worker sweeper — null until the first warning fires.
  /// Prevents the same threshold being re-sent on a later sweep tick.
  lastWarningThresholdDays Int? @map("last_warning_threshold_days")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  activationGrants ActivationGrant[]

  // Composite-FK target for ActivationGrant, matching SchoolMembership's
  // proven (schoolId, id) pattern.
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("subscriptions")
}

/// Distinguishes an unauthenticated first-activation redemption (target
/// User still INVITED, no session possible yet) from an authenticated
/// renewal redemption (target User already ACTIVE, checked against the
/// caller's own session inside ActivationService) — see B3's plan decision
/// 3. Not named anywhere in 07 §4.3; a mechanical necessity the same shape
/// as B1's User.email addition.
enum ActivationGrantPurpose {
  INITIAL_ACTIVATION
  RENEWAL
}

enum ActivationGrantStatus {
  ISSUED
  ACTIVATED
  EXPIRED
  REVOKED
}

/// Issued activation/renewal authorization (07 §4.3). Only the key's sha256
/// is stored — the raw value exists only in the outbound email — mirroring
/// PasswordResetToken's convention. issuedAt/issuedBy/keyHash are immutable
/// after activation (enforced at the service layer, same honest scope as
/// AuditEvent's own not-yet-DB-enforced immutability); single-use is
/// enforced by a partial unique index in this migration's hand-written SQL.
model ActivationGrant {
  id             String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId       String                 @map("school_id") @db.Uuid
  subscriptionId String                 @map("subscription_id") @db.Uuid
  purpose        ActivationGrantPurpose
  keyHash        String                 @unique @map("key_hash") @db.VarChar(64)
  issuedBy       String                 @map("issued_by") @db.Uuid
  issuedAt       DateTime               @default(now()) @map("issued_at") @db.Timestamptz(6)
  activatedAt    DateTime?              @map("activated_at") @db.Timestamptz(6)
  expiresAt      DateTime               @map("expires_at") @db.Timestamptz(6)
  status         ActivationGrantStatus  @default(ISSUED)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [schoolId, subscriptionId], references: [schoolId, id], onDelete: Cascade)
  issuer       User         @relation(fields: [issuedBy], references: [id], onDelete: Restrict)

  @@index([schoolId])
  @@index([subscriptionId])
  @@map("activation_grants")
}

/// Software Admin's session record — parallels Session (B1) but is
/// deliberately a separate, tenant-independent table rather than a
/// nullable-schoolId Session row, mirroring PlatformRoleAssignment's own
/// precedent exactly: Session is RLS-protected school-owned infrastructure
/// B1 already hardened, and a nullable-schoolId carve-out there would risk
/// exactly the class of subtle RLS bug @atlas/db's tenancy.ts already
/// documents avoiding (see withTenant's own history). Not RLS-protected
/// (not school-owned); exempted in scripts/lint-schema-tenancy.mjs alongside
/// User/School/PlatformRoleAssignment. Own cookie name
/// (PlatformSessionService) so a school session and a platform session can
/// never be confused for one another.
model PlatformSession {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Points at the session this one replaced via POST /platform/auth/refresh
  /// equivalent rotation — mirrors Session.rotatedFromId exactly.
  rotatedFromId String?   @unique @map("rotated_from_id") @db.Uuid
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address") @db.VarChar(64)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedFrom PlatformSession? @relation("PlatformSessionRotation", fields: [rotatedFromId], references: [id])
  rotatedTo   PlatformSession? @relation("PlatformSessionRotation")

  @@index([userId])
  @@map("platform_sessions")
}
