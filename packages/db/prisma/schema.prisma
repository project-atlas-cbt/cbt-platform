// ExamKeep — Prisma schema.
//
// B0 delivered the tenancy CONVENTION (School + the TenancyProbe scaffolding
// that proved it). B1 delivers the first real domain — Identity & Auth
// (docs/roadmaps/backend-roadmap.md "B1") — and, per TenancyProbe's own doc
// comment, drops the scaffolding now that a real school-owned table exists
// to carry the isolation-test suite instead (see
// tests/tenancy/rls.integration.test.ts, rewritten against
// SchoolMembership).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// This custom `output` sits outside node_modules, in our own source tree —
// so the generated client's CJS runtime bundle (loaded via createRequire
// even though this package is "type": "module") resolves its own
// dependencies by climbing node_modules from THAT location, not from
// wherever @prisma/client itself lives. Under pnpm's strict, non-hoisted
// linking, that climb only reaches what packages/db declares directly —
// hence @prisma/client-runtime-utils is listed as an explicit dependency
// in package.json even though it's really a dependency of @prisma/client.
// Symptom if this drifts out of sync on a future @prisma/client bump:
// `Cannot find module '@prisma/client-runtime-utils'` at app boot (only
// via plain `node`, not `tsx` — see apps/api's `start` script).

// Prisma 7: the connection URL is no longer set here. Migrate reads it from
// prisma.config.ts's `datasource.url`; PrismaClient at runtime takes a
// driver adapter instead (see src/client.ts) — both resolve DATABASE_URL
// via @atlas/config's loadRootEnv(), never a URL hardcoded in schema.
datasource db {
  provider = "postgresql"
}

/// Tenant root. Full school lifecycle fields (status, subscription, address)
/// arrived in B3; branding fields (logo, primary colour) arrived in B4 —
/// this model is extended, not replaced, by both. Derived palette is never
/// stored (computed on read by @atlas/domain's derivePalette).
///
/// B3 note: "School identifier" (05 §3.2's required, generated, unique
/// creation field) IS `subdomain` — ADR-0005 already froze it as the unique
/// tenant-resolution key derived from the school's name/code, so B3 does not
/// add a redundant separate `school_code` column despite 07 §4.1 listing one.
model School {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  subdomain String @unique @db.VarChar(63)
  timezone  String @default("Africa/Lagos")

  // --- B3: school profile fields (07 §4.1), set post-activation via
  // PATCH /v1/school/profile (03 §4 Step 1) — not required at platform
  // creation (05 §3.2's narrower required-field list).
  shortName    String? @map("short_name") @db.VarChar(32)
  contactEmail String? @map("contact_email") @db.VarChar(320)
  contactPhone String? @map("contact_phone") @db.VarChar(32)
  address      String?

  // --- B4: branding (03 §5, 05 §6.1), set via PUT /v1/school/branding.
  // Freely editable by School Admin at any time (audit finding A-18's
  // resolution — see packages/domain's schoolConfig.colour.set row); every
  // change is audited (SCHOOL_BRANDING_CHANGED). Plain (non-composite) FK
  // to MediaAsset — the pointed-to asset's own schoolId/type/status
  // (READY, SCHOOL_LOGO) are re-validated at the service layer before this
  // is ever assigned, not enforced by the FK itself.
  logoMediaId  String? @map("logo_media_id") @db.Uuid
  /// "#rrggbb" — validated at the DTO layer (see UpdateSchoolBrandingDto).
  primaryColor String? @map("primary_color") @db.VarChar(7)

  /// Derived, cached access-gate label (ADR-0016) — recomputed by
  /// @atlas/domain's resolveSchoolStatus on every subscription/activation/
  /// platform-action mutation (AccessGateService). Never set independently
  /// outside that recomputation; never read directly by a guard — every
  /// guard calls AccessGateService instead (ADR-0016: "no guard reads either
  /// field directly").
  status           SchoolStatus            @default(PROVISIONAL)
  /// Explicit Software-Admin platform action (suspend/deactivate),
  /// independent of and taking precedence over the subscription-derived
  /// state (ADR-0016 precedence: DEACTIVATED > SUSPENDED > subscription-
  /// derived). Null = no override — the subscription-derived status governs.
  platformOverride SchoolPlatformOverride? @map("platform_override")

  // --- F4: onboarding wizard progress (03 §3, 05 §5.1-5.2), set via
  // GET/PUT /v1/school/onboarding and POST /v1/school/onboarding/complete.
  // Null = onboarding not yet completed — gates the School Admin's post-
  // login landing route (never read by AuthGuard/AccessGateService; this is
  // a routing concern, not an access-gate one).
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  /// Ephemeral UI-progress only: {currentStep: number, skippedSteps: number[]}.
  /// Never consulted for business-rule enforcement — completion eligibility
  /// is always recomputed live from AcademicSession/ClassGroup state on
  /// POST .../complete, never cached here.
  onboardingState       Json?     @map("onboarding_state")

  // --- F5/B3 gap-closure: result-policy defaults + lock (05 §47, 07 §8.1,
  // ADR-0010's own "Required changes" list: "B5/B3: school-level defaults
  // and the lock flag" — approved scope B3/B5 never actually built). Seeds
  // Exam.result_policy/result_detail_visibility at exam creation once B11
  // exists; resultPolicyLocked governs whether a teacher may override the
  // seeded value (enforced by B15, not here — B15's own DoD item 7). Set via
  // GET/PUT /v1/school/result-policy. Defaults are this gap-closure's own
  // engineering call (no spec-mandated default exists): SCHOOL_ADMIN/not-
  // AUTOMATIC so results never auto-release without an explicit action;
  // SCORE_AND_COUNTS as a middle-ground default; unlocked until a School
  // Admin chooses to lock it.
  resultPolicy           ResultPolicy           @default(SCHOOL_ADMIN) @map("result_policy")
  resultDetailVisibility ResultDetailVisibility @default(SCORE_AND_COUNTS) @map("result_detail_visibility")
  resultPolicyLocked     Boolean                @default(false) @map("result_policy_locked")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         SchoolMembership[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]
  notifications       Notification[]
  subscriptions       Subscription[]
  activationGrants    ActivationGrant[]
  mediaAssets         MediaAsset[]         @relation("SchoolMediaAssets")
  /// The currently-active logo asset, if any. `onDelete: SetNull` — a
  /// superseded/removed MediaAsset row is never deleted by this relation
  /// (D-13 immutability), so this only fires if something else removes the
  /// row; the school simply falls back to no logo, never a dangling FK.
  logoMedia           MediaAsset?          @relation("SchoolLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  // --- B5: academic structure back-relations.
  academicSessions    AcademicSession[]
  departments         Department[]
  exportJobs          ExportJob[]

  @@map("schools")
}

/// Persisted School.status label (07 §4.1) — see School.status's own doc
/// comment for the derivation rule (@atlas/domain's resolveSchoolStatus).
enum SchoolStatus {
  PROVISIONAL
  ACTIVE
  SUSPENDED
  EXPIRED
  DEACTIVATED
}

/// The two platform actions Software Admin can set directly on School.status
/// (ADR-0016). A separate enum from SchoolStatus (not a nullable subset of
/// it) so no other SchoolStatus value can ever be assigned to this column by
/// mistake — only these two platform actions are valid overrides.
enum SchoolPlatformOverride {
  SUSPENDED
  DEACTIVATED
}

/// F5/B3 gap-closure (05 §47, ADR-0010) — who releases a result: the exam's
/// own teacher, School Admin, or the system immediately upon finalisation.
/// Seeds Exam.result_policy at exam creation once B11 exists.
enum ResultPolicy {
  TEACHER
  SCHOOL_ADMIN
  AUTOMATIC
}

/// F5/B3 gap-closure (ADR-0010's second, independent policy axis) — what a
/// student sees once a result is released: bare score, score plus counts, or
/// a full per-question review. Vocabulary is this gap-closure's own naming
/// choice — no prior enum identifiers existed anywhere in the docs/code for
/// this axis (ADR-0010 only describes it in prose).
enum ResultDetailVisibility {
  SCORE_ONLY
  SCORE_AND_COUNTS
  FULL_REVIEW
}

// ---------------------------------------------------------------------------
// Identity & Access domain (07 §5, 06 §6-12) — B1.
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// 07 §5.1 lists "authentication state" and "account status" as two
/// distinct User attributes; this enum is the former. Kept separate from
/// UserStatus (the latter) per audit C-14's status-precedence resolution —
/// a SUSPENDED user and a user who merely hasn't set a password yet are
/// different facts and must not share one field.
enum CredentialState {
  /// Invited, no password set — must arrive via the initial-credential flow
  /// (staff: invitation link; student: system-generated password) before
  /// any authenticated route works.
  MUST_SET_PASSWORD
  /// A password exists but is a system-generated temporary one (student
  /// initial password) — every authenticated route except
  /// POST /auth/password/change is blocked until it's changed (B1 DoD
  /// item 8: "cannot be bypassed by calling any other endpoint").
  MUST_CHANGE_PASSWORD
  OK
}

enum MembershipStatus {
  PENDING
  ACTIVE
  INACTIVE
  ENDED
}

/// Mirrors @atlas/domain's ROLES (packages/domain/src/roles.ts) exactly —
/// Prisma enums can't import a TS const, so the two are hand-kept in sync.
/// roles.test.ts and this schema's own lint (scripts/lint-schema-tenancy.mjs
/// doesn't check this, but B2's authorization engine — the next consumer —
/// will fail loudly on drift) are the guardrails.
enum Role {
  SOFTWARE_ADMIN
  SCHOOL_ADMIN
  MODERATOR
  HOD
  TEACHER
  STUDENT
}

enum RoleAssignmentStatus {
  ACTIVE
  ENDED
}

/// Academic standing only (audit C-14's resolution) — never consulted by
/// login itself, only by scope/eligibility logic later phases build.
enum StudentProfileStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN
  ARCHIVED
}

enum EmploymentStatus {
  ACTIVE
  ENDED
}

/// Represents a person's authentication/account identity (06 §6). Deliberately
/// tenant-independent — no school_id — because one physical person may hold
/// SchoolMembership at more than one school (06 §7/§9's own example); RLS
/// therefore does not apply here (nothing to scope it by), and this model is
/// exempted in scripts/lint-schema-tenancy.mjs alongside School.
///
/// `login_identifier` deliberately does NOT live here despite 07 §5.1 listing
/// it as a User attribute: ADR-0005 requires it unique *per school*, not
/// globally (so two schools can each have student "ST001"), which only
/// SchoolMembership — the entity that already represents "this person's
/// relationship with this school" (07 §5.2) — can express without giving
/// User a school_id and breaking the multi-school membership model this
/// same file documents two sections later. See SchoolMembership.loginIdentifier.
model User {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  firstName       String          @map("first_name")
  lastName        String          @map("last_name")
  displayName     String          @map("display_name")
  /// ADR-0019: staff-facing flows (password reset, invitations) need an
  /// email address to deliver to; students have none by design (no
  /// institutional email — see ADR-0019's Context) and this stays null for
  /// them. Not an auth identifier — see SchoolMembership.loginIdentifier for
  /// that. Not required to be globally unique: no spec mandates it, and a
  /// person could plausibly share a personal address across two accounts.
  email           String?         @db.VarChar(320)
  /// Argon2id hash (09 §24). Null until the first credential is set —
  /// MUST_SET_PASSWORD accounts have no hash yet.
  passwordHash    String?         @map("password_hash")
  credentialState CredentialState @default(MUST_SET_PASSWORD) @map("credential_state")
  status          UserStatus      @default(INVITED)
  lastLoginAt     DateTime?       @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships             SchoolMembership[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  platformRoleAssignments PlatformRoleAssignment[]
  platformSessions        PlatformSession[]
  platformMfaCredential   PlatformMfaCredential?
  issuedActivationGrants  ActivationGrant[]
  uploadedMediaAssets     MediaAsset[]

  @@map("users")
}

/// A user's relationship with a school (07 §5.2). School-owned — carries
/// the tenancy convention's denormalised school_id.
model SchoolMembership {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId        String           @map("school_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  /// Per-school-unique login identifier (staff username, or school-issued
  /// student ID like "ST001") — see User's doc comment for why this lives
  /// here rather than on User. ADR-0005.
  loginIdentifier String           @map("login_identifier") @db.VarChar(64)
  status          MembershipStatus @default(PENDING)
  joinedAt        DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt          DateTime?        @map("left_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  school              School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleAssignments     RoleAssignment[]
  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  hodAssignments      HODAssignment[]
  // B9: reviews this membership has personally decided, as reviewer.
  questionReviews     QuestionReview[]
  // B11: exams this membership has authored (createdByMembershipId).
  examsCreated        Exam[]              @relation("ExamCreatedBy")
  // B12: exam-administrator delegations held by this membership (ADR-0012/M-15).
  examAdministrations ExamAdministrator[]

  // Composite-FK target for RoleAssignment/StudentProfile/TeacherProfile,
  // matching TenancyProbe's proven (schoolId, id) pattern.
  @@unique([schoolId, id])
  @@unique([schoolId, loginIdentifier])
  @@index([schoolId])
  @@index([userId])
  @@map("school_memberships")
}

/// A role within a school membership (07 §5.3) — a membership may hold more
/// than one (e.g. TEACHER + HOD).
model RoleAssignment {
  id            String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId      String               @map("school_id") @db.Uuid
  membershipId  String               @map("membership_id") @db.Uuid
  role          Role
  effectiveFrom DateTime             @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime?            @map("effective_to") @db.Timestamptz(6)
  status        RoleAssignmentStatus @default(ACTIVE)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership SchoolMembership @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, membershipId])
  @@map("role_assignments")
}

/// Student-specific academic identity (07 §5.4). 0..1 per membership.
model StudentProfile {
  id              String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId        String               @map("school_id") @db.Uuid
  membershipId    String               @map("membership_id") @db.Uuid
  studentId       String               @map("student_id") @db.VarChar(32)
  admissionNumber String?              @map("admission_number") @db.VarChar(32)
  status          StudentProfileStatus @default(ACTIVE)
  admissionDate   DateTime?            @map("admission_date") @db.Timestamptz(6)
  graduationDate  DateTime?            @map("graduation_date") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership                SchoolMembership         @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Cascade)
  enrollments               StudentEnrollment[]
  // B12: this student's session authorizations and final per-exam outcomes.
  examSessionParticipations ExamSessionParticipant[]
  examParticipations        ExamParticipation[]
  attemptAuthorizations     AttemptAuthorization[]
  // B13: this student's actual attempts.
  examAttempts              ExamAttempt[]
  // B15: this student's finalised results.
  results                   Result[]

  @@unique([schoolId, membershipId])
  @@unique([schoolId, studentId])
  // Composite-FK target for StudentEnrollment (B6) — every other
  // composite-FK-target table already carries this exact line.
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("student_profiles")
}

/// Teacher-specific operational identity (07 §5.5). 0..1 per membership.
model TeacherProfile {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId         String           @map("school_id") @db.Uuid
  membershipId     String           @map("membership_id") @db.Uuid
  staffId          String           @map("staff_id") @db.VarChar(32)
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  hireDate         DateTime?        @map("hire_date") @db.Timestamptz(6)
  endDate          DateTime?        @map("end_date") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership        SchoolMembership    @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Cascade)
  assignments       TeacherAssignment[]
  // B8: a Question's author is always a TeacherProfile — see
  // Question.authorTeacherProfileId's own doc comment.
  authoredQuestions Question[]

  @@unique([schoolId, membershipId])
  @@unique([schoolId, staffId])
  // Composite-FK target for TeacherAssignment (B6) — every other
  // composite-FK-target table already carries this exact line.
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("teacher_profiles")
}

/// Server-side session record (ADR-0022). The bearer cookie value is never
/// stored — only its sha256, so a database read alone can't forge a
/// session. Roles are never derived from this row; every authenticated
/// request re-reads RoleAssignment live (09 §25).
model Session {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Points at the session this one replaced via POST /auth/refresh — the
  /// old row's revokedAt is set atomically with creating this one.
  rotatedFromId String?   @unique @map("rotated_from_id") @db.Uuid
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address") @db.VarChar(64)

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedFrom Session? @relation("SessionRotation", fields: [rotatedFromId], references: [id])
  rotatedTo   Session? @relation("SessionRotation")

  @@index([schoolId])
  @@index([userId])
  @@map("sessions")
}

/// Single-use staff password-reset token (ADR-0019). Students have no email
/// and never receive one — see credential-sheet.service.ts for their path.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Authorization & Tenancy Engine (08 §10, 07 §41-42) — B2.
// ---------------------------------------------------------------------------

/// SOFTWARE_ADMIN's schema representation (2026-08-26 decision, confirmed
/// with the project owner before implementation — see CLAUDE.md's B2
/// Change Log entry). Deliberately tenant-independent, mirroring User
/// itself: a platform role has no school to be owned by, so it cannot live
/// under SchoolMembership the way RoleAssignment does. Exempted in
/// scripts/lint-schema-tenancy.mjs alongside User/School.
///
/// Only SOFTWARE_ADMIN is a real row here today (PLATFORM_ROLES in
/// @atlas/domain has exactly one member) — the `role` column reuses the
/// shared Role enum rather than a new one-member enum so a future second
/// platform role (none currently planned) would not require a schema
/// migration to the enum itself, only a new CHECK constraint entry. The
/// CHECK constraint (see this model's migration) rejects any school-role
/// value here at the database level, not just in application code.
model PlatformRoleAssignment {
  id            String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  role          Role
  effectiveFrom DateTime             @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime?            @map("effective_to") @db.Timestamptz(6)
  status        RoleAssignmentStatus @default(ACTIVE)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_role_assignments")
}

/// Minimal, real append-only audit primitive — deliberately not the full
/// B10 deliverable (07 §11.1's canonical action vocabulary, retrieval
/// endpoints, DB-enforced immutability trigger, retention policy). B2
/// needs a genuine write path now for ADR-0012's break-glass requirement
/// ("emits an elevated audit event") the same way B0 shipped a minimal
/// NotificationChannel ahead of a full B10-equivalent — B10 builds the
/// rest of the apparatus on top of this same table, not a replacement for
/// it. See apps/api's AuditService (OperationsModule).
///
/// School-owned: `schoolId` is the *affected* school (per ADR-0012, break-
/// glass events must be "visible to the target school"), not necessarily
/// the actor's own school — Software Admin has none. Writing a row here
/// for a cross-tenant break-glass action deliberately goes through
/// `withTenant(prisma, targetSchoolId, ...)`, the same controlled,
/// explicit bypass path @atlas/db's tenancy.ts already anticipated for B2.
model AuditEvent {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Null only for platform-level events with no affected school (B20:
  /// Software Admin MFA, platform login, operator commands). Such rows are
  /// insert-only for atlas_app (a dedicated RLS policy) and readable only
  /// through atlas_audit_reader.
  schoolId    String?  @map("school_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  actorRole   Role     @map("actor_role")
  /// Free-form (e.g. "BREAK_GLASS_FORCE_PASSWORD_RESET") — deliberately not
  /// a DB enum. 07 §11.1's canonical vocabulary (resolving audit finding
  /// C-02) is enforced at the application layer instead
  /// (packages/domain/src/audit/vocabulary.ts's CANONICAL_AUDIT_ACTIONS +
  /// AuditActionRegistry/AuditVocabularyCoverageService, B10) — this column
  /// already carries 55+ distinct, correctly-named action strings across
  /// every module that writes here, and forcing a migration on every new
  /// one would fight this codebase's own pace. See that file for the full
  /// canonical-vs-shipped mapping.
  action      String   @db.VarChar(64)
  entityType  String?  @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.Uuid
  reason      String?
  breakGlass  Boolean  @default(false) @map("break_glass")
  metadata    Json?
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  /// B20: Restrict, not Cascade — invariant 15 (audit is append-only)
  /// means a school with audit history can never be deleted out from under
  /// it; the immutability trigger already made a cascade fail, this makes
  /// the schema say so.
  school School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId])
  @@index([schoolId, occurredAt])
  @@index([schoolId, actorUserId, occurredAt]) // B10: Teacher "own actions" / Student "own account" (GET /v1/audit)
  @@index([schoolId, action, occurredAt]) // B10: action filter (GET /v1/audit, GET /v1/platform/audit)
  @@index([schoolId, entityType, entityId]) // B10: entity filter + HOD department resolution
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Audit & Notifications (07 §11.1-11.2, 03 §57, 05 §56-57, 06 §63-64) — B10.
// ---------------------------------------------------------------------------

/// 07 §11.2's own example list, plus the three deferred types declared now
/// so their owning phase only needs to add a producer, never a migration
/// (mirroring this codebase's own "ship the enum value ahead of use"
/// precedent — e.g. ExamStatus's unused-but-shipped values).
enum NotificationType {
  QUESTION_APPROVED
  QUESTION_REJECTED
  /// B9's own third decision (REQUEST_CHANGES) — not one of 07 §11.1's six
  /// named types, but the identical producer as the other two.
  QUESTION_CHANGES_REQUESTED
  /// DEFERRED — no producer until B15 (Result Publication).
  RESULT_PUBLISHED
  /// DEFERRED — no producer until B12 (Exam Activation & Control).
  EXAM_OPENED
  /// DEFERRED — no producer until B16 (Participation, Absence & Makeup).
  MAKEUP_GRANTED
  SUBSCRIPTION_EXPIRING
  STUDENTS_UNASSIGNED
}

enum NotificationStatus {
  UNREAD
  READ
}

/// 07 §11.2: "operational only, never social" (04 §64). Recipient-scoped,
/// in-app; out-of-band delivery (email) for the types that need to reach a
/// logged-out user is a *separate* concern handled by the ADR-0019
/// NotificationChannel/retry-queue pipeline (packages/notifications,
/// apps/api/src/modules/notification-center) — this row is always written
/// regardless of whether an out-of-band send also happens.
model Notification {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId          String             @map("school_id") @db.Uuid
  recipientUserId   String             @map("recipient_user_id") @db.Uuid
  type              NotificationType
  title             String             @db.VarChar(200)
  content           String
  status            NotificationStatus @default(UNREAD)
  relatedEntityType String?            @map("related_entity_type") @db.VarChar(64)
  relatedEntityId   String?            @map("related_entity_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt            DateTime?          @map("read_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// GET /v1/notifications (recipient's own list, unread-first) + the
  /// unread-count derivation, and the unassigned-students digest's own
  /// "did the count actually change since I last notified this Moderator"
  /// lookup (apps/worker/src/queues/unassigned-students-digest.queue.ts).
  @@index([schoolId, recipientUserId, status, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Platform, Schools & Subscriptions (07 §4, 03 §2-3/§66-67, ADR-0012/0015/
// 0016/0019) — B3.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRING
  EXPIRED
  SUSPENDED
  CANCELLED
}

/// Commercial truth (ADR-0016) — School.status is a derived, cached label
/// computed from this plus SchoolPlatformOverride via @atlas/domain's
/// resolveSchoolStatus/resolveAccessGate, never read directly by a guard.
/// One school may have many historical Subscription rows; at most one is
/// ever PENDING/ACTIVE/EXPIRING at a time — enforced by a partial unique
/// index in this migration's hand-written SQL (Prisma's schema DSL can't
/// express a filtered/partial unique constraint).
///
/// SUSPENDED/CANCELLED exist in the enum to match 07 §4.2 exactly, but no B3
/// endpoint ever sets them — no spec'd action triggers a subscription-level
/// (as opposed to school-level, SchoolPlatformOverride) suspend/cancel.
/// @atlas/domain's resolveSchoolStatus defends against them defensively
/// (collapsing to the same restricted EXPIRED label). Recorded as
/// Candidate/Deferred in CLAUDE.md.
model Subscription {
  id                       String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId                 String             @map("school_id") @db.Uuid
  plan                     String             @db.VarChar(64)
  startAt                  DateTime           @map("start_at") @db.Timestamptz(6)
  expiresAt                DateTime           @map("expires_at") @db.Timestamptz(6)
  status                   SubscriptionStatus @default(PENDING)
  /// Highest pre-expiry warning threshold (days before expiresAt) already
  /// dispatched by the worker sweeper — null until the first warning fires.
  /// Prevents the same threshold being re-sent on a later sweep tick.
  lastWarningThresholdDays Int?               @map("last_warning_threshold_days")
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  activationGrants ActivationGrant[]

  // Composite-FK target for ActivationGrant, matching SchoolMembership's
  // proven (schoolId, id) pattern.
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("subscriptions")
}

/// Distinguishes an unauthenticated first-activation redemption (target
/// User still INVITED, no session possible yet) from an authenticated
/// renewal redemption (target User already ACTIVE, checked against the
/// caller's own session inside ActivationService) — see B3's plan decision
/// 3. Not named anywhere in 07 §4.3; a mechanical necessity the same shape
/// as B1's User.email addition.
enum ActivationGrantPurpose {
  INITIAL_ACTIVATION
  RENEWAL
}

enum ActivationGrantStatus {
  ISSUED
  ACTIVATED
  EXPIRED
  REVOKED
}

/// Issued activation/renewal authorization (07 §4.3). Only the key's sha256
/// is stored — the raw value exists only in the outbound email — mirroring
/// PasswordResetToken's convention. issuedAt/issuedBy/keyHash are immutable
/// after activation (enforced at the service layer, same honest scope as
/// AuditEvent's own not-yet-DB-enforced immutability); single-use is
/// enforced by a partial unique index in this migration's hand-written SQL.
model ActivationGrant {
  id             String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId       String                 @map("school_id") @db.Uuid
  subscriptionId String                 @map("subscription_id") @db.Uuid
  purpose        ActivationGrantPurpose
  keyHash        String                 @unique @map("key_hash") @db.VarChar(64)
  issuedBy       String                 @map("issued_by") @db.Uuid
  issuedAt       DateTime               @default(now()) @map("issued_at") @db.Timestamptz(6)
  activatedAt    DateTime?              @map("activated_at") @db.Timestamptz(6)
  expiresAt      DateTime               @map("expires_at") @db.Timestamptz(6)
  status         ActivationGrantStatus  @default(ISSUED)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [schoolId, subscriptionId], references: [schoolId, id], onDelete: Cascade)
  issuer       User         @relation(fields: [issuedBy], references: [id], onDelete: Restrict)

  @@index([schoolId])
  @@index([subscriptionId])
  @@map("activation_grants")
}

/// Software Admin's session record — parallels Session (B1) but is
/// deliberately a separate, tenant-independent table rather than a
/// nullable-schoolId Session row, mirroring PlatformRoleAssignment's own
/// precedent exactly: Session is RLS-protected school-owned infrastructure
/// B1 already hardened, and a nullable-schoolId carve-out there would risk
/// exactly the class of subtle RLS bug @atlas/db's tenancy.ts already
/// documents avoiding (see withTenant's own history). Not RLS-protected
/// (not school-owned); exempted in scripts/lint-schema-tenancy.mjs alongside
/// User/School/PlatformRoleAssignment. Own cookie name
/// (PlatformSessionService) so a school session and a platform session can
/// never be confused for one another.
model PlatformSession {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Points at the session this one replaced via POST /platform/auth/refresh
  /// equivalent rotation — mirrors Session.rotatedFromId exactly.
  rotatedFromId String?   @unique @map("rotated_from_id") @db.Uuid
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address") @db.VarChar(64)
  /// B20: last authenticated request, for the platform idle timeout
  /// (PLATFORM_SESSION_IDLE_TIMEOUT_SECONDS). Written at most once a minute
  /// by PlatformAuthGuard, not on every request. Null on rows that predate B20
  /// — treated as "seen at createdAt".
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(6)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedFrom PlatformSession? @relation("PlatformSessionRotation", fields: [rotatedFromId], references: [id])
  rotatedTo   PlatformSession? @relation("PlatformSessionRotation")

  @@index([userId])
  @@map("platform_sessions")
}

/// B20 (08 §16 "stronger controls" for administrative operations; project-
/// owner decision 2026-10-02): TOTP second factor for Software Admin. A
/// platform table like PlatformSession — no school, no RLS (see
/// scripts/lint-schema-tenancy.mjs EXEMPT_MODELS). One credential per user;
/// `confirmedAt` null means enrolment was started but never proved with a
/// first code, and such a credential never gates login.
model PlatformMfaCredential {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  /// AES-256-GCM ciphertext of the base32 TOTP secret (iv.tag.ciphertext,
  /// base64url), keyed by MFA_ENCRYPTION_KEY — never the plain secret.
  secretCiphertext String    @map("secret_ciphertext")
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz(6)
  /// Highest TOTP time-step ever accepted — a code at or below it is
  /// rejected, so an observed code can't be replayed inside its window.
  lastUsedStep     Int?      @map("last_used_step")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes PlatformMfaRecoveryCode[]

  @@map("platform_mfa_credentials")
}

/// B20: single-use recovery codes, issued once at enrolment confirmation.
/// Stored as sha256 of an 80-bit random code — never recoverable.
model PlatformMfaRecoveryCode {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  credentialId String    @map("credential_id") @db.Uuid
  codeHash     String    @unique @map("code_hash") @db.VarChar(64)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  credential PlatformMfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId])
  @@map("platform_mfa_recovery_codes")
}

// ---------------------------------------------------------------------------
// Media, Storage & Branding (07 §7.4/§11.3, 09 §22, ADR-0021) — B4.
// ---------------------------------------------------------------------------

/// 07 §11.3's fixed list — order matters for stable UI select lists, do not
/// reorder. REPORT is never client-uploadable (system-generated only, B18/
/// ADR-0030 — unbuilt); the media endpoints reject any client request for
/// this type outright, before any permission check runs. IMPORT_SOURCE (B7)
/// is likewise never reachable through the generic MediaController — it has
/// its own dedicated upload-target/complete pair in ImportsController,
/// gated by `users.import.students`/`users.import.teachers` rather than
/// `media.upload` (whose grant vocabulary — Teacher/HOD SCHOOL-scope — does
/// not apply to import files), mirroring SCHOOL_LOGO's own precedent
/// exactly (see media.module.ts's doc comment for why one route can't
/// cleanly enforce two different permission rows on request-body content).
enum MediaAssetType {
  SCHOOL_LOGO
  QUESTION_IMAGE
  QUESTION_DIAGRAM
  REPORT
  OTHER
  IMPORT_SOURCE
}

/// The two-step upload lifecycle (request target → client PUTs bytes
/// directly to storage → complete/validate). PENDING: a presigned PUT was
/// issued, the object isn't confirmed in the bucket yet. READY: complete()
/// ran, content was sniffed and (for images) dimension-checked, and it
/// passed. REJECTED: complete() ran but validation failed — the row (and
/// bucket object, if one landed) is kept, never deleted; only a future
/// M-14 retention policy deletes anything. There is no "REPLACED" status —
/// D-13 ("never overwritten") is satisfied structurally, not by a status
/// value: see MediaAsset's own doc comment.
enum MediaAssetStatus {
  PENDING
  READY
  REJECTED
}

/// One immutable record per upload (D-13). There is no service method
/// anywhere that mutates storageKey/declaredMimeType/declaredSizeBytes
/// after creation — a "replace" is always a brand-new MediaAsset row plus,
/// where applicable, a pointer swap (School.logoMediaId reassigned to the
/// new row). id is generated by the application (uuidv7(), not
/// dbgenerated) because it's part of the storage key computed before
/// insert — see MediaService.buildStorageKey.
model MediaAsset {
  id       String           @id @db.Uuid
  schoolId String           @map("school_id") @db.Uuid
  type     MediaAssetType
  status   MediaAssetStatus @default(PENDING)

  /// Key shape (09 §22): schools/SCHOOL_ID/CATEGORY/MEDIA_ASSET_ID/FILENAME,
  /// where CATEGORY is branding, questions, reports, or other — globally
  /// unique by construction (MEDIA_ASSET_ID is a fresh UUIDv7 per upload);
  /// the @@unique below is belt-and-suspenders, not the actual uniqueness
  /// mechanism. (Curly-brace placeholders deliberately avoided in this
  /// comment — scripts/lint-schema-tenancy.mjs parses model bodies with a
  /// brace-matching regex that such a placeholder would break.)
  storageKey       String @unique @map("storage_key") @db.VarChar(512)
  originalFilename String @map("original_filename") @db.VarChar(255)

  /// Client-declared at POST /v1/media/uploads request time — never
  /// trusted alone; complete() re-derives sniffedMimeType from the actual
  /// bytes (magic-byte sniffing, not extension/declared-type trust).
  declaredMimeType String  @map("declared_mime_type") @db.VarChar(127)
  /// Set by complete() after magic-byte sniffing; null until then.
  sniffedMimeType  String? @map("sniffed_mime_type") @db.VarChar(127)

  /// Client-declared at request time, used to pin Content-Length on the
  /// presigned PUT. Not independently re-verified beyond what the storage
  /// layer itself enforces via that signed Content-Length.
  declaredSizeBytes Int @map("declared_size_bytes")

  /// Populated for image types at complete() time (image-size); null for
  /// non-image OTHER assets or before completion.
  width  Int?
  height Int?

  uploaderUserId  String  @map("uploader_user_id") @db.Uuid
  /// Set only when status = REJECTED — the specific validation failure.
  rejectionReason String? @map("rejection_reason")

  /// Presigned-PUT expiry (~15 min from creation) — the orphan-media
  /// sweep's signal for "upload was requested and abandoned."
  uploadUrlExpiresAt DateTime @map("upload_url_expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school             School          @relation("SchoolMediaAssets", fields: [schoolId], references: [id], onDelete: Cascade)
  uploader           User            @relation(fields: [uploaderUserId], references: [id], onDelete: Restrict)
  schoolsUsingAsLogo School[]        @relation("SchoolLogo")
  // B8: QuestionMedia join rows pointing at this asset (an asset may be
  // referenced by more than one revision's QuestionMedia row — see
  // QuestionMedia's own doc comment on why that's still D-13-safe).
  questionMedia      QuestionMedia[]

  // Composite-FK target, matching every other school-owned table's
  // (schoolId, id) convention, for a future composite reference (e.g. B8's
  // QuestionMedia) — not consumed by anything in B4 itself.
  examCiphertexts ExamMediaCiphertext[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, type])
  @@index([schoolId, status])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// Academic Structure (07 §6.1-6.9, 03 §6-9, 05 §7.1-7.5, ADR-0001/0011/0013)
// — B5.
//
// Delivers the session-scoped academic hierarchy every later phase depends
// on: AcademicSession, AcademicTerm, Department, ClassGroup, Subject,
// ClassSubject, HODAssignment. TeacherAssignment/StudentEnrollment/
// StudentSubjectRegistration (ADR-0011) are B6; Topic/Question.level
// (ADR-0001) are B8 despite that ADR's own "Required changes" text loosely
// naming B5 too — the roadmap's own B5 and B8 Scope sections both
// independently place Topic in B8, which this phase follows (see CLAUDE.md's
// B5 Change Log entry for the documentation-inconsistency note). ExamClass
// (ADR-0013) is B11.
// ---------------------------------------------------------------------------

enum AcademicSessionStatus {
  DRAFT
  UPCOMING
  CURRENT
  CLOSED
  ARCHIVED
}

enum AcademicTermStatus {
  DRAFT
  UPCOMING
  CURRENT
  CLOSED
  ARCHIVED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

/// ADR-0001: "ClassGroup.level becomes load-bearing for authorization, so
/// its values must be consistent within a school — level is now a
/// controlled vocabulary, not free text." Fixed platform-wide enum
/// (confirmed with the project owner during B5 planning), not a
/// school-editable lookup table — B8's Question.level and B9's HOD/teacher
/// scope joins, and B11's cross-class level-agreement check, all compare
/// against this enum directly; a school-defined free-text level would break
/// every one of those joins.
enum ClassLevel {
  JSS1
  JSS2
  JSS3
  SS1
  SS2
  SS3
}

enum ClassGroupStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

enum ClassSubjectStatus {
  ACTIVE
  INACTIVE
}

enum HODAssignmentStatus {
  ACTIVE
  ENDED
}

enum RolloverPlanStatus {
  DRAFT
  READY
  COMMITTED
}

enum RolloverOutcome {
  PROMOTE
  REPEAT
  TRANSFER
  GRADUATE
  WITHDRAW
}

/// School's academic year (07 §6.1). Exactly one CURRENT session per school
/// is enforced structurally by a partial unique index in this migration's
/// hand-written SQL (Prisma's DSL can't express a filtered unique index) —
/// see this migration's raw SQL block and SessionService's activation
/// transaction for the app-level transition semantics layered on top.
model AcademicSession {
  id        String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId  String                @map("school_id") @db.Uuid
  name      String                @db.VarChar(32)
  startDate DateTime              @map("start_date") @db.Date
  endDate   DateTime              @map("end_date") @db.Date
  status    AcademicSessionStatus @default(DRAFT)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  school                         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms                          AcademicTerm[]
  classGroups                    ClassGroup[]
  classSubjects                  ClassSubject[]
  hodAssignments                 HODAssignment[]
  studentEnrollments             StudentEnrollment[]
  rolloverSourceSessionDecisions RolloverDecision[]  @relation("RolloverDecisionSourceSession")
  teacherAssignments             TeacherAssignment[]
  // B11: exams held in this session.
  exams                          Exam[]

  // Composite-FK target for AcademicTerm/ClassGroup/ClassSubject/
  // HODAssignment, matching the established (schoolId, id) convention.
  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("academic_sessions")
}

/// A term within a session (07 §6.2). `sequence` orders terms within their
/// session (1, 2, 3) and is the uniqueness key alongside the session, not
/// itself globally meaningful.
model AcademicTerm {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId          String             @map("school_id") @db.Uuid
  academicSessionId String             @map("academic_session_id") @db.Uuid
  name              String             @db.VarChar(32)
  sequence          Int
  startDate         DateTime           @map("start_date") @db.Date
  endDate           DateTime           @map("end_date") @db.Date
  status            AcademicTermStatus @default(DRAFT)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  session AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: Cascade)
  // B11: exams held in this term.
  exams   Exam[]

  @@unique([schoolId, academicSessionId, sequence])
  // Composite-FK target for Exam (B11) — every other composite-FK-target
  // table already carries this exact line; AcademicTerm didn't need it
  // until B11 gave it its first FK-consuming child.
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, academicSessionId])
  @@index([schoolId, status])
  @@map("academic_terms")
}

/// NOT session-scoped — persists across sessions (07 §6.3, 03 §7: "not
/// hard-coded restrictions", school-defined). HODAssignment (session-scoped)
/// is what carries the temporal dimension, not Department itself.
model Department {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId  String           @map("school_id") @db.Uuid
  name      String           @db.VarChar(128)
  code      String           @db.VarChar(16)
  status    DepartmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects       Subject[]
  classGroups    ClassGroup[]
  hodAssignments HODAssignment[]
  // B11: exams denormalized to this department (from Subject.departmentId
  // at creation time).
  exams          Exam[]

  // Composite-FK target for Subject/ClassGroup/HODAssignment.
  @@unique([schoolId, id])
  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("departments")
}

/// Session-scoped class identity (07 §6.4, ADR-0001 confirmed): "SS2A
/// 2026/27" and "SS2A 2027/28" are distinct rows with distinct ids, so
/// StudentEnrollment (B6) never overwrites history by reusing one row
/// across academic years. `departmentId` is nullable — JSS classes
/// typically have no department in the Nigerian secondary structure this
/// platform targets first; streaming into Science/Arts/Commercial starts at
/// SS level.
model ClassGroup {
  id                String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId          String           @map("school_id") @db.Uuid
  academicSessionId String           @map("academic_session_id") @db.Uuid
  departmentId      String?          @map("department_id") @db.Uuid
  name              String           @db.VarChar(32)
  level             ClassLevel
  arm               String           @db.VarChar(16)
  status            ClassGroupStatus @default(ACTIVE)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  session                 AcademicSession     @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: Cascade)
  /// Restrict, not SetNull: a composite FK can't null just one of its two
  /// columns (schoolId is required), and our own archival rule already
  /// blocks hard-deleting a Department while any ClassGroup references it —
  /// Restrict is a correct database-level backstop under that rule, not a
  /// contradiction of "departmentId is nullable" (nullable only means a
  /// class *may be created* with no department).
  department              Department?         @relation(fields: [schoolId, departmentId], references: [schoolId, id], onDelete: Restrict)
  classSubjects           ClassSubject[]
  // B6: StudentEnrollment FKs against the (schoolId, id, academicSessionId)
  // unique below (the same D-10-style guarantee ClassSubject already uses).
  studentEnrollments      StudentEnrollment[]
  rolloverSourceDecisions RolloverDecision[]  @relation("RolloverDecisionSourceClass")

  // Composite-FK target for ClassSubject's session-agreement check (D-10) —
  // a three-column unique, not just (schoolId, id), so ClassSubject can FK
  // against (schoolId, classId, academicSessionId) and structurally cannot
  // reference a (class, session) pair that disagrees.
  @@unique([schoolId, id, academicSessionId])
  @@unique([schoolId, id])
  // Unique class identity within (school, session) — roadmap Database work.
  @@unique([schoolId, academicSessionId, level, arm])
  @@index([schoolId])
  @@index([schoolId, academicSessionId])
  @@index([schoolId, departmentId])
  @@index([schoolId, status])
  @@map("class_groups")
}

/// NOT session-scoped (07 §6.5: "can exist across multiple sessions").
/// `departmentId` nullable per ADR-0001 — a subject with no department falls
/// outside every HOD's automatic review scope and requires explicit
/// assignment.
model Subject {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId     String        @map("school_id") @db.Uuid
  departmentId String?       @map("department_id") @db.Uuid
  name         String        @db.VarChar(128)
  code         String        @db.VarChar(16)
  status       SubjectStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Restrict, not SetNull — same reasoning as ClassGroup.department.
  department    Department?    @relation(fields: [schoolId, departmentId], references: [schoolId, id], onDelete: Restrict)
  classSubjects ClassSubject[]
  // B8: Question/Topic back-relations.
  questions     Question[]
  topics        Topic[]
  // B11: exams held in this subject.
  exams         Exam[]

  // Composite-FK target for ClassSubject.
  @@unique([schoolId, id])
  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, departmentId])
  @@index([schoolId, status])
  @@map("subjects")
}

/// "Mathematics taught to SS2A in 2026/2027" (07 §6.6) — the future
/// registration target for B6's StudentSubjectRegistration (ADR-0011).
/// `academicSessionId` is redundant against `classId`'s own
/// ClassGroup.academicSessionId (audit finding D-10) — the composite FK
/// below is what makes divergence impossible at the database level, not
/// just a service-layer check (roadmap Database work, DoD item 7).
model ClassSubject {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId          String             @map("school_id") @db.Uuid
  classId           String             @map("class_id") @db.Uuid
  subjectId         String             @map("subject_id") @db.Uuid
  academicSessionId String             @map("academic_session_id") @db.Uuid
  status            ClassSubjectStatus @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject           Subject         @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Restrict)
  session           AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: Cascade)
  /// The load-bearing composite FK (D-10): targets ClassGroup's three-column
  /// unique above, not merely (schoolId, id) — so a row can only ever point
  /// at a (class, session) pair that actually agree.
  classGroupSession ClassGroup      @relation(fields: [schoolId, classId, academicSessionId], references: [schoolId, id, academicSessionId], onDelete: Cascade)

  teacherAssignments TeacherAssignment[]
  registrations      StudentSubjectRegistration[]
  // B11: ExamClass rows targeting this class+subject+session.
  examClasses        ExamClass[]

  @@unique([schoolId, classId, subjectId])
  // Composite-FK target for TeacherAssignment/StudentSubjectRegistration
  // (B6) — every other composite-FK-target table (SchoolMembership,
  // AcademicSession, Department, Subject) already carries this exact line;
  // ClassSubject didn't need it until B6 gave it FK-consuming children.
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, classId])
  @@index([schoolId, subjectId])
  @@index([schoolId, academicSessionId])
  @@map("class_subjects")
}

/// References membership_id, not user_id (resolves audit finding D-11) — a
/// person's HOD standing is a fact about their SchoolMembership at this
/// school, not about the User globally, mirroring RoleAssignment/
/// StudentProfile/TeacherProfile's own membershipId convention exactly.
/// Session-scoped, mirroring ClassGroup's own session-scoping. Rejects a
/// membership lacking an active HOD RoleAssignment — enforced at the
/// service layer (see HodAssignmentService.create), not a DB constraint,
/// since it's a cross-table invariant and this codebase avoids triggers.
model HODAssignment {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId          String              @map("school_id") @db.Uuid
  membershipId      String              @map("membership_id") @db.Uuid
  departmentId      String              @map("department_id") @db.Uuid
  academicSessionId String              @map("academic_session_id") @db.Uuid
  startDate         DateTime            @map("start_date") @db.Date
  endDate           DateTime?           @map("end_date") @db.Date
  status            HODAssignmentStatus @default(ACTIVE)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership SchoolMembership @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Cascade)
  department Department       @relation(fields: [schoolId, departmentId], references: [schoolId, id], onDelete: Restrict)
  session    AcademicSession  @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, membershipId])
  @@index([schoolId, departmentId])
  @@index([schoolId, academicSessionId])
  @@map("hod_assignments")
}

// ---------------------------------------------------------------------------
// B6 — People, Profiles & Enrollment (docs/roadmaps/backend-roadmap.md "B6").
// StudentEnrollment/TeacherAssignment/StudentSubjectRegistration on top of
// B5's session-scoped structural half, per academics.module.ts's own doc
// comment anticipating exactly this. Person directory models (User/
// SchoolMembership/RoleAssignment/StudentProfile/TeacherProfile) already
// exist from B1 — B6 adds no new person-identity columns, only lifecycle
// behaviour on top of them (UsersModule) plus these three placement/
// assignment entities (AcademicsModule).
// ---------------------------------------------------------------------------

/// Session-scoped student placement (07 §6.7) — never a mutable
/// current_class. Moving a student closes the old row (TRANSFERRED) and
/// creates a new one in the same transaction; the old row is never
/// overwritten (07 §35's worked example). Field names follow the ERD
/// literally (student_profile_id, not membership_id).
model StudentEnrollment {
  id                String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId          String                  @map("school_id") @db.Uuid
  studentProfileId  String                  @map("student_profile_id") @db.Uuid
  academicSessionId String                  @map("academic_session_id") @db.Uuid
  classId           String                  @map("class_id") @db.Uuid
  startDate         DateTime                @map("start_date") @db.Date
  endDate           DateTime?               @map("end_date") @db.Date
  status            StudentEnrollmentStatus @default(ACTIVE)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentProfile          StudentProfile               @relation(fields: [schoolId, studentProfileId], references: [schoolId, id], onDelete: Cascade)
  session                 AcademicSession              @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: Cascade)
  /// D-10-style composite FK against ClassGroup's three-column unique —
  /// structurally guarantees the enrollment's session agrees with the
  /// class's own session, same pattern as ClassSubject.classGroupSession.
  /// Restrict (not Cascade): a class must not be hard-deletable while a
  /// live or historical enrollment still references it — backstops
  /// ClassGroupService.delete()'s own dependent-count check.
  classGroupSession       ClassGroup                   @relation(fields: [schoolId, classId, academicSessionId], references: [schoolId, id, academicSessionId], onDelete: Restrict)
  registrations           StudentSubjectRegistration[]
  rolloverSourceDecisions RolloverDecision[]           @relation("RolloverDecisionSourceEnrollment")
  // DoD item 9 ("a student cannot be enrolled twice concurrently in one
  // session") is enforced by a partial unique index on
  // (school_id, student_profile_id, academic_session_id) WHERE
  // status = 'ACTIVE' — Prisma's DSL can't express a filtered unique index,
  // so it's added by hand in this migration's raw SQL (same precedent as
  // AcademicSession's "one CURRENT per school").

  // Composite-FK target for StudentSubjectRegistration.
  @@unique([schoolId, id])
  // B19 decision evidence binds a historical enrollment to the exact source
  // session, not merely to an enrollment UUID.
  @@unique([schoolId, id, academicSessionId])
  @@index([schoolId])
  @@index([schoolId, studentProfileId])
  @@index([schoolId, classId])
  @@index([schoolId, academicSessionId])
  @@index([schoolId, status])
  @@map("student_enrollments")
}

enum StudentEnrollmentStatus {
  ACTIVE
  TRANSFERRED // moved to another class — 07 §6.7's literal state list
  COMPLETED
  WITHDRAWN
}

/// 07 §6.8 — "the core authorization entity." Field names follow the ERD
/// literally (teacher_profile_id, not membership_id), matching
/// StudentEnrollment's same choice. The real ASSIGNED scope resolver
/// (assigned-scope.resolver.ts) reads this table directly.
model TeacherAssignment {
  id                String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId          String                  @map("school_id") @db.Uuid
  teacherProfileId  String                  @map("teacher_profile_id") @db.Uuid
  classSubjectId    String                  @map("class_subject_id") @db.Uuid
  academicSessionId String                  @map("academic_session_id") @db.Uuid
  startDate         DateTime                @map("start_date") @db.Date
  endDate           DateTime?               @map("end_date") @db.Date
  status            TeacherAssignmentStatus @default(ACTIVE)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacherProfile TeacherProfile  @relation(fields: [schoolId, teacherProfileId], references: [schoolId, id], onDelete: Cascade)
  classSubject   ClassSubject    @relation(fields: [schoolId, classSubjectId], references: [schoolId, id], onDelete: Restrict)
  session        AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: Cascade)
  // "At most one ACTIVE assignment per (teacher, classSubject) pair" is a
  // partial unique index (added by hand in this migration's raw SQL,
  // same reason as StudentEnrollment above) — not a plain @@unique, since
  // re-assigning the same pair after ending it (rehire) must stay possible.

  @@index([schoolId])
  @@index([schoolId, teacherProfileId])
  @@index([schoolId, classSubjectId])
  @@index([schoolId, academicSessionId])
  @@index([schoolId, status])
  @@map("teacher_assignments")
}

enum TeacherAssignmentStatus {
  ACTIVE
  ENDED
}

/// ADR-0011 (Accepted, mandatory — resolves audit finding M-02). Keyed on
/// (student enrollment, class subject), not directly on the student —
/// auto-created on enrollment for every ACTIVE ClassSubject of the target
/// class; a Moderator can deregister/re-register within an active
/// enrollment. Tying registrations to the ENROLLMENT row (not the student
/// directly) is what makes a past enrollment's registrations stay
/// historically frozen once superseded by a move, with no explicit
/// "close old registrations" step required — see
/// StudentEnrollmentService's class-movement logic.
model StudentSubjectRegistration {
  id                  String                           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId            String                           @map("school_id") @db.Uuid
  studentEnrollmentId String                           @map("student_enrollment_id") @db.Uuid
  classSubjectId      String                           @map("class_subject_id") @db.Uuid
  status              StudentSubjectRegistrationStatus @default(REGISTERED)
  registeredAt        DateTime                         @default(now()) @map("registered_at") @db.Timestamptz(6)
  deregisteredAt      DateTime?                        @map("deregistered_at") @db.Timestamptz(6)
  createdAt           DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment   StudentEnrollment @relation(fields: [schoolId, studentEnrollmentId], references: [schoolId, id], onDelete: Cascade)
  classSubject ClassSubject      @relation(fields: [schoolId, classSubjectId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, studentEnrollmentId, classSubjectId])
  @@index([schoolId])
  @@index([schoolId, studentEnrollmentId])
  @@index([schoolId, classSubjectId])
  @@index([schoolId, status])
  @@map("student_subject_registrations")
}

enum StudentSubjectRegistrationStatus {
  REGISTERED
  DEREGISTERED
}

// ---------------------------------------------------------------------------
// B19 — Academic Session Rollover. Draft rows are deliberately separate
// from live academic structure: nothing acquires operational meaning until
// the plan's single commit transaction materialises it in the target session.
// ---------------------------------------------------------------------------
model RolloverPlan {
  id                      String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId                String             @map("school_id") @db.Uuid
  sourceAcademicSessionId String             @map("source_academic_session_id") @db.Uuid
  targetAcademicSessionId String             @map("target_academic_session_id") @db.Uuid
  status                  RolloverPlanStatus @default(DRAFT)
  readinessSnapshot       Json               @map("readiness_snapshot")
  version                 Int                @default(1)
  generatedByUserId       String             @map("generated_by_user_id") @db.Uuid
  committedAt             DateTime?          @map("committed_at") @db.Timestamptz(6)
  committedByUserId       String?            @map("committed_by_user_id") @db.Uuid
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([schoolId, sourceAcademicSessionId])
  // A destination is reserved by exactly one plan. There is intentionally no
  // cancellation state: a new destination session is created if a plan must
  // be abandoned, so two historical sessions can never race into one target.
  @@unique([schoolId, targetAcademicSessionId])
  @@unique([schoolId, id])
  @@index([schoolId, targetAcademicSessionId])
  @@index([schoolId, status])
  @@map("rollover_plans")
}

model RolloverDecision {
  id                      String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId                String          @map("school_id") @db.Uuid
  rolloverPlanId          String          @map("rollover_plan_id") @db.Uuid
  sourceEnrollmentId      String          @map("source_enrollment_id") @db.Uuid
  sourceAcademicSessionId String          @map("source_academic_session_id") @db.Uuid
  sourceClassId           String          @map("source_class_id") @db.Uuid
  proposedOutcome         RolloverOutcome @map("proposed_outcome")
  outcome                 RolloverOutcome
  targetDraftClassId      String?         @map("target_draft_class_id") @db.Uuid
  reason                  String          @db.VarChar(500)
  overriddenByUserId      String?         @map("overridden_by_user_id") @db.Uuid
  overriddenAt            DateTime?       @map("overridden_at") @db.Timestamptz(6)
  committedAt             DateTime?       @map("committed_at") @db.Timestamptz(6)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceEnrollment StudentEnrollment @relation("RolloverDecisionSourceEnrollment", fields: [schoolId, sourceEnrollmentId], references: [schoolId, id], onDelete: Restrict)
  sourceClass      ClassGroup        @relation("RolloverDecisionSourceClass", fields: [schoolId, sourceClassId], references: [schoolId, id], onDelete: Restrict)
  sourceSession    AcademicSession   @relation("RolloverDecisionSourceSession", fields: [schoolId, sourceAcademicSessionId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, rolloverPlanId, sourceEnrollmentId])
  @@index([schoolId, rolloverPlanId])
  @@index([schoolId, targetDraftClassId])
  @@map("rollover_decisions")
}

model RolloverClassDraft {
  id             String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId       String     @map("school_id") @db.Uuid
  rolloverPlanId String     @map("rollover_plan_id") @db.Uuid
  sourceClassId  String     @map("source_class_id") @db.Uuid
  departmentId   String?    @map("department_id") @db.Uuid
  name           String     @db.VarChar(32)
  level          ClassLevel
  arm            String     @db.VarChar(16)
  included       Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([schoolId, rolloverPlanId, sourceClassId])
  @@unique([schoolId, rolloverPlanId, id])
  @@unique([schoolId, id])
  @@index([schoolId, rolloverPlanId])
  @@map("rollover_class_drafts")
}

model RolloverOfferingDraft {
  id                   String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId             String   @map("school_id") @db.Uuid
  rolloverPlanId       String   @map("rollover_plan_id") @db.Uuid
  sourceClassSubjectId String   @map("source_class_subject_id") @db.Uuid
  targetDraftClassId   String   @map("target_draft_class_id") @db.Uuid
  subjectId            String   @map("subject_id") @db.Uuid
  included             Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([schoolId, rolloverPlanId, sourceClassSubjectId])
  @@unique([schoolId, rolloverPlanId, id])
  @@index([schoolId, targetDraftClassId])
  @@map("rollover_offering_drafts")
}

model RolloverStaffAssignmentDraft {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId           String   @map("school_id") @db.Uuid
  rolloverPlanId     String   @map("rollover_plan_id") @db.Uuid
  assignmentKind     String   @map("assignment_kind") @db.VarChar(16)
  sourceAssignmentId String   @map("source_assignment_id") @db.Uuid
  membershipId       String   @map("membership_id") @db.Uuid
  targetDraftClassId String?  @map("target_draft_class_id") @db.Uuid
  subjectId          String?  @map("subject_id") @db.Uuid
  departmentId       String?  @map("department_id") @db.Uuid
  confirmed          Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([schoolId, rolloverPlanId, assignmentKind, sourceAssignmentId])
  @@index([schoolId, rolloverPlanId])
  @@map("rollover_staff_assignment_drafts")
}

// ---------------------------------------------------------------------------
// B7 — Bulk Import Pipeline (docs/roadmaps/backend-roadmap.md "B7", A-17).
// ImportJob/ImportRow — student and teacher import shipped in B7; question
// import (QUESTIONS below) was added in B8 once the Question model existed
// (roadmap's own "Sequence student/teacher import first if B8 is not
// ready"). Writes through UsersModule/AcademicsModule/QuestionsModule's
// existing services (createPersonMembership, StudentEnrollmentService.enroll,
// IdentityService.issueStaffInvitation, QuestionService.createFromImportRow),
// never directly to their tables — see ImportModule's own doc comment.
// ---------------------------------------------------------------------------

enum ImportJobType {
  STUDENTS
  TEACHERS
  /// B8 — Question Bank. Always creates DRAFT questions (05 §18: "never
  /// auto-approved"); author is the uploader's own TeacherProfile — see
  /// QuestionService.createFromImportRow's own doc comment for why a
  /// non-teacher uploader (permitted by questionBank.import's grant, e.g.
  /// Moderator) still fails structurally without one.
  QUESTIONS
}

/// PENDING_VALIDATION -> VALIDATING -> VALIDATED -> IMPORTING -> COMPLETED
/// is the happy path. FAILED is a whole-file rejection (bad template
/// version, unparsable file, row/size cap exceeded) — no ImportRow exists
/// for a FAILED job. EXPIRED is set by the staging-expiry sweep (A-17) on a
/// VALIDATED job nobody confirmed within the window; confirm() also
/// lazily rejects an expired job even between sweeps.
enum ImportJobStatus {
  PENDING_VALIDATION
  VALIDATING
  VALIDATED
  IMPORTING
  COMPLETED
  FAILED
  EXPIRED
}

/// VALID/INVALID are the validation job's outcome for this row. COMMITTED
/// means the commit job fully finished this row (person created *and*, for
/// students, enrolled / for teachers, invited). FAILED (row-level) is the
/// rare case a row passed validation but hit a genuine unrecoverable error
/// at commit time. The commit job's resumability query is `WHERE status =
/// 'VALID'` alone — `resultMembershipId` is a finer-grained progress marker
/// *within* that: null means "person not created yet," non-null-but-still-
/// VALID means "person created, enrollment/invitation not yet confirmed
/// done" (a resumed row picks up from there, calling the idempotent
/// enroll()/re-sending the invitation rather than re-creating the person —
/// see ImportCommitService's own doc comment for the full reasoning).
enum ImportRowStatus {
  VALID
  INVALID
  COMMITTED
  FAILED
}

/// One row per uploaded file (D-13-style: never overwritten by a later
/// upload — a re-upload is always a new ImportJob). `sourceMediaAssetId`
/// points at the IMPORT_SOURCE MediaAsset holding the raw file — the
/// pipeline never stores the file's bytes a second time. `targetAcademicSessionId`
/// is always resolved (from the caller's explicit choice, or the school's
/// current CURRENT session) before validation runs, never left implicit at
/// commit time — every row's Class resolution happens against this one
/// session. Nullable — TEACHERS imports never resolve or need one (the
/// manual `TeacherService.create` flow takes no session parameter either);
/// only ever null for that type, always set for STUDENTS.
/// `templateVersion` records which template version the header
/// row matched, for audit/debugging, not re-checked after VALIDATED.
/// `uploaderRole` is captured at creation time (the authenticated actor who
/// started the import) because the commit job runs in the background, with
/// no HTTP request/actor context of its own, yet still calls into
/// StudentEnrollmentService.enroll()/AuditService.record() — both of which
/// require a real Role for their own audit trail, exactly as if the
/// uploader had performed each row's creation manually.
model ImportJob {
  id                      String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId                String          @map("school_id") @db.Uuid
  type                    ImportJobType
  status                  ImportJobStatus @default(PENDING_VALIDATION)
  sourceMediaAssetId      String          @map("source_media_asset_id") @db.Uuid
  uploaderUserId          String          @map("uploader_user_id") @db.Uuid
  uploaderRole            Role            @map("uploader_role")
  targetAcademicSessionId String?         @map("target_academic_session_id") @db.Uuid
  templateVersion         Int             @map("template_version")

  totalRows     Int @default(0) @map("total_rows")
  validRows     Int @default(0) @map("valid_rows")
  invalidRows   Int @default(0) @map("invalid_rows")
  committedRows Int @default(0) @map("committed_rows")
  failedRows    Int @default(0) @map("failed_rows")

  /// Set only when status = FAILED — the whole-file rejection reason (bad
  /// template version, unparsable file, row-count cap exceeded).
  failureReason String? @map("failure_reason")

  /// A-17 "staging expiry" — 24h from creation. Only meaningful while
  /// status = VALIDATED; confirm() checks this before honouring a confirm
  /// call, and the import-expiry sweep marks stale VALIDATED jobs EXPIRED.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  /// A lease, not a status: ImportCommitService.commit() atomically claims
  /// a job (conditional UPDATE ... WHERE status = 'IMPORTING' AND
  /// (processing_claimed_at IS NULL OR stale), mirroring confirm()'s own
  /// VALIDATED -> IMPORTING conditional-update idiom) before processing it,
  /// and clears this back to null when it finishes. Guards against two
  /// overlapping commit() executions on the same job (e.g. a BullMQ
  /// stalled-lock redelivery landing on a second worker while the first is
  /// still genuinely alive and running) both fetching and processing the
  /// same batch of VALID rows concurrently. A stale claim (older than the
  /// commit loop could plausibly still be running) is self-healing — no
  /// separate sweep needed, since the only way a claim outlives that window
  /// is the process that held it having died.
  processingClaimedAt DateTime? @map("processing_claimed_at") @db.Timestamptz(6)

  /// B22 (ADR-0028 retention; project-owner decision 6A, 2026-10-04): when
  /// the uploaded source file was deleted from object storage — 90 days
  /// after the job finished (with the raw cells), or at once when any person
  /// it created is redacted (the whole file: it holds other people's rows
  /// too). The job row and its outcome counts stay as the record.
  sourcePurgedAt DateTime? @map("source_purged_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rows ImportRow[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("import_jobs")
}

/// One row per parsed data row of the uploaded file (never per header/
/// comment line). `rawData` is the parsed cell values keyed by the
/// template's own column names — both the error-CSV download and the
/// commit job read from this, never re-parsing the original file.
model ImportRow {
  id          String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId    String          @map("school_id") @db.Uuid
  importJobId String          @map("import_job_id") @db.Uuid
  rowNumber   Int             @map("row_number")
  rawData     Json            @map("raw_data")
  status      ImportRowStatus @default(INVALID)

  /// An array of field/message validation-error objects — null once a row
  /// is VALID/COMMITTED, since there is nothing left to correct. (Curly-
  /// brace placeholders deliberately avoided in this comment — see
  /// MediaAsset's own doc comment for why: scripts/lint-schema-tenancy.mjs
  /// parses model bodies with a brace-matching regex that such a
  /// placeholder would break.)
  errors Json?

  /// Set as soon as the commit job creates this row's person — *before*
  /// status flips to COMMITTED (see ImportRowStatus's own doc comment). The
  /// SchoolMembership this row produced. STUDENTS/TEACHERS only — a
  /// QUESTIONS row uses resultQuestionId below instead (a person and a
  /// question are not the same kind of "result," and this codebase avoids
  /// overloading one column across unrelated meanings).
  resultMembershipId String? @map("result_membership_id") @db.Uuid
  /// B8 — the Question this row produced. Unlike resultMembershipId's two-
  /// step progress marker (person created, then enrolled/invited), question
  /// creation is one atomic transaction (Question + initial revision +
  /// options) — so for a QUESTIONS row this field is simply null-until-done,
  /// set in the same transaction that flips status to COMMITTED.
  resultQuestionId   String? @map("result_question_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  job ImportJob @relation(fields: [schoolId, importJobId], references: [schoolId, id], onDelete: Cascade)

  @@index([schoolId])
  // The commit job's own resumability query:
  // WHERE school_id = ? AND import_job_id = ? AND status = 'VALID' — this
  // composite index is what makes that scan cheap even for a 5,000-row job
  // re-run after a crash. (resultMembershipId is read per-row, not
  // filtered on, since a non-null value mid-VALID means "resume from
  // enrollment/invitation," not "skip" — see ImportRowStatus.)
  @@index([schoolId, importJobId, status])
  @@map("import_rows")
}

// ---------------------------------------------------------------------------
// B8 — Question Bank (docs/roadmaps/backend-roadmap.md "B8", ADR-0001,
// audit findings C-04/D-12/A-16/D-13).
//
// Question/QuestionRevision/QuestionOption/QuestionMedia/Topic. Immutable
// approved revisions (DoD item 6) are enforced by real Postgres triggers in
// this migration's hand-written SQL — the first trigger-enforced constraint
// anywhere in this schema. QuestionReview (07 §7.5 — HOD approve/reject/
// comment) is explicitly NOT built here; it is B9's "Question review
// workflow" (see packages/domain's permission-table.ts, questionBank.review/
// .approve/.reject/.requestChanges/.comment.* rows). B8's own endpoints only
// ever move a revision DRAFT -> SUBMITTED; SUBMITTED -> UNDER_REVIEW ->
// APPROVED/REJECTED has no B8 route — B8's own tests construct those states
// directly via Prisma, mirroring import-commit-resume.integration.test.ts's
// and session-activation-concurrency.integration.test.ts's own precedent for
// this, never a hidden endpoint.
// ---------------------------------------------------------------------------

/// 05 §15.2's core-scope types only — the model allows future types (e.g.
/// multiple-select, short answer, essay) without redesign (07 §7.3's
/// "never four hardcoded option columns" already anticipates this), but only
/// these two are enabled in B8. Deferred types are Candidate/Deferred, not
/// silently built ahead of spec.
enum QuestionType {
  SINGLE_CHOICE
  TRUE_FALSE
}

/// No spec document gives a controlled vocabulary for this axis verbatim —
/// this three-value set is an engineering default (low-stakes: not
/// load-bearing for authorization or immutability, unlike ClassLevel/
/// Question.level, and trivially extensible later without a migration
/// touching any FK).
enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

/// 07 §7.2's lifecycle. ARCHIVED is kept for spec fidelity but never written
/// by any B8 code path — archiving happens at the Question level only (see
/// Question.archivedAt's own doc comment), so the immutability trigger below
/// never needs an ARCHIVED-transition carve-out. Recorded as Candidate for
/// B9 to decide whether an individual stale (non-current) revision ever
/// needs this value in its own right.
enum QuestionRevisionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

/// The reusable question identity (07 §7.1) — never the exact text/options a
/// student sees (that's QuestionRevision, the unit of approval and
/// immutability). `level` (ADR-0001 §2) reuses ClassLevel verbatim: a
/// question belongs to a level ("SS2"), reusable across every arm of that
/// level, not scoped to one class/arm — scoping to arm would defeat the
/// reusable-bank premise 06 §25 describes.
///
/// current_status (D-12) is deliberately NOT a stored column. It is always
/// derived: `archivedAt !== null ? 'ARCHIVED' : currentRevision.status`.
/// currentRevisionId is a pointer set once per revision-creation transaction
/// and never touched by a status transition (submit/approve/reject all
/// mutate the *same* row this pointer already references) — so the derived
/// value can never disagree with the real one, satisfying the audit's "if
/// materialised, maintain it in the same transaction... with a test
/// asserting the two never disagree" recommendation by construction rather
/// than a synced duplicate column.
model Question {
  id                     String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId               String     @map("school_id") @db.Uuid
  subjectId              String     @map("subject_id") @db.Uuid
  level                  ClassLevel
  /// A Question's author must hold a real TeacherProfile — only Teachers
  /// author questions (questionBank.create's grant: TEACHER ASSIGNED only,
  /// every other role denied). See QuestionService.createFromImportRow's
  /// own doc comment for how the bulk-import path enforces the same rule
  /// against a non-teacher uploader.
  authorTeacherProfileId String     @map("author_teacher_profile_id") @db.Uuid
  /// D-12 pointer — see this model's own doc comment above. Nullable only
  /// for the instant between the Question insert and its initial revision
  /// insert within the same create() transaction; no committed row is ever
  /// observed with this null in practice. Plain (non-composite) FK below,
  /// like School.logoMediaId's own precedent — QuestionRevision.id is
  /// already globally unique (UUIDv7), and this pointer is always set in
  /// the same transaction as creating a revision already scoped to this
  /// same school, so cross-tenant mismatch is prevented by construction
  /// rather than needing schoolId in the FK itself (which would also make
  /// SetNull invalid here, since Question.schoolId is required).
  currentRevisionId      String?    @unique @map("current_revision_id") @db.Uuid
  /// 07 §7.1 places archival on Question, not the revision — archiving
  /// never mutates any QuestionRevision row (mirrors ClassGroup/Subject's
  /// own "deactivation is always allowed, never touches historical rows"
  /// precedent). DoD item 7's "still bound to any exam using it" — an
  /// archived Question's APPROVED revision is untouched by this field.
  archivedAt             DateTime?  @map("archived_at") @db.Timestamptz(6)
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject         Subject            @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Restrict)
  authorProfile   TeacherProfile     @relation(fields: [schoolId, authorTeacherProfileId], references: [schoolId, id], onDelete: Restrict)
  /// SetNull: a same-aggregate self-referencing pointer, not a cross-
  /// aggregate FK — structurally cannot legitimately dangle (a revision is
  /// never deleted once submitted, and the trigger below blocks deleting an
  /// APPROVED one outright), but SetNull is still the correct defensive
  /// default over Restrict/Cascade here.
  currentRevision QuestionRevision?  @relation("QuestionCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  revisions       QuestionRevision[] @relation("QuestionRevisions")

  // Composite-FK target for QuestionRevision/QuestionOption/QuestionMedia.
  @@unique([schoolId, id])
  @@index([schoolId])
  // Roadmap's own literal bank index — split from its "...status" suffix
  // since status is derived (lives on QuestionRevision), not a Question
  // column; Postgres narrows by this index first, then joins to
  // currentRevision by primary key.
  @@index([schoolId, subjectId, level])
  @@index([schoolId, authorTeacherProfileId])
  @@map("questions")
}

/// 07 §7.2 — the unit of approval and immutability. Every post-submission
/// edit cycle creates a brand-new row (05 §17's worked example: Revision
/// 1 -> Rejected, Revision 2 -> Approved, Revision 3 -> Rejected, Revision
/// 4 -> Approved) — only a still-DRAFT (never yet submitted) revision is
/// edited in place. Once APPROVED, this row is immutable at the database
/// level (this migration's hand-written trigger), not only in application
/// code — DoD item 6.
model QuestionRevision {
  id                    String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId              String                 @map("school_id") @db.Uuid
  questionId            String                 @map("question_id") @db.Uuid
  /// Monotonic per question (DB work spec item 1) — enforced by the
  /// @@unique below, never reused even across DRAFT/REJECTED history.
  revisionNumber        Int                    @map("revision_number")
  questionType          QuestionType           @map("question_type")
  content               String
  topicId               String?                @map("topic_id") @db.Uuid
  subtopicId            String?                @map("subtopic_id") @db.Uuid
  difficulty            QuestionDifficulty
  /// Int, not Decimal — no spec text calls for fractional marks, and this
  /// would be the first Decimal-typed column anywhere in this schema;
  /// kept consistent with the rest of the codebase's whole-number
  /// conventions rather than introducing a new numeric pattern
  /// unnecessarily.
  marks                 Int
  explanation           String?
  /// Who authored *this* revision specifically (07 §7.2's own attribute,
  /// independent of Question.authorTeacherProfileId) — in practice always
  /// the question's own author today (only OWNED-scoped Teacher writes
  /// exist), but kept as its own field for audit fidelity rather than
  /// implicitly assumed equal to the parent Question's author.
  createdByMembershipId String                 @map("created_by_membership_id") @db.Uuid
  status                QuestionRevisionStatus @default(DRAFT)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  question   Question  @relation("QuestionRevisions", fields: [schoolId, questionId], references: [schoolId, id], onDelete: Cascade)
  currentFor Question? @relation("QuestionCurrentRevision")
  /// Restrict: a Topic referenced by any revision (draft or historical)
  /// must never be hard-deletable out from under it.
  topic      Topic?    @relation("RevisionTopic", fields: [schoolId, topicId], references: [schoolId, id], onDelete: Restrict)
  subtopic   Topic?    @relation("RevisionSubtopic", fields: [schoolId, subtopicId], references: [schoolId, id], onDelete: Restrict)

  options       QuestionOption[]
  media         QuestionMedia[]
  // B9: this revision's own review history (07 §7.5) — 1:N, append-only.
  reviews       QuestionReview[]
  // B11: ExamQuestion rows binding this specific (immutable-once-APPROVED)
  // revision to an exam — never Question.currentRevisionId, which is what
  // makes a later revision not retroactively alter an existing binding.
  examQuestions ExamQuestion[]

  @@unique([schoolId, questionId, revisionNumber])
  // Composite-FK target for QuestionOption/QuestionMedia, and the target of
  // Question.currentRevisionId above.
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, questionId])
  // Roadmap's own literal counts index — also directly reusable by B9's
  // HOD review queue (all SUBMITTED/UNDER_REVIEW revisions school-wide),
  // mirroring department-scope.resolver.ts's own forward-looking precedent
  // of shaping an index for a consumer one phase ahead.
  @@index([schoolId, status])
  @@map("question_revisions")
}

/// 07 §7.3. Never four hardcoded A/B/C/D columns (06 §27) — arbitrary
/// option count per revision, `originalOrder` preserves authoring order
/// independent of any later attempt-time shuffle (a B13 concern, not
/// stored here). Immutable once the parent revision is APPROVED — this
/// migration's second trigger, since these rows carry no status of their
/// own to check directly.
model QuestionOption {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId           String   @map("school_id") @db.Uuid
  questionRevisionId String   @map("question_revision_id") @db.Uuid
  content            String
  originalOrder      Int      @map("original_order")
  correctFlag        Boolean  @default(false) @map("correct_flag")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  revision QuestionRevision @relation(fields: [schoolId, questionRevisionId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, questionRevisionId, originalOrder])
  @@index([schoolId])
  @@index([schoolId, questionRevisionId])
  @@map("question_options")
}

/// 07 §7.4. `mediaType` is deliberately not re-declared here — read off the
/// joined MediaAsset.type (QUESTION_IMAGE/QUESTION_DIAGRAM) instead of
/// duplicating that vocabulary. D-13: a new revision created from an
/// APPROVED/REJECTED source (POST .../revisions) always gets fresh
/// QuestionMedia rows, even when pointing at the same still-valid
/// MediaAsset — the underlying asset is genuinely reusable, but the join
/// row is revision-specific, so the old revision's own QuestionMedia rows
/// are never reassigned. Immutable once the parent revision is APPROVED —
/// this migration's third trigger (an extension slightly beyond the
/// roadmap's literal "content, options, correct answer, marks" wording, but
/// necessary for D-13's "never silently added/removed from an approved
/// revision" to hold against every mutation path, not just column edits).
model QuestionMedia {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId           String   @map("school_id") @db.Uuid
  questionRevisionId String   @map("question_revision_id") @db.Uuid
  mediaAssetId       String   @map("media_asset_id") @db.Uuid
  displayOrder       Int      @map("display_order")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  revision   QuestionRevision @relation(fields: [schoolId, questionRevisionId], references: [schoolId, id], onDelete: Cascade)
  /// Restrict: there is no MediaAsset delete path anywhere in this codebase
  /// today (D-13), but Restrict is the correct backstop regardless.
  mediaAsset MediaAsset       @relation(fields: [schoolId, mediaAssetId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, questionRevisionId, mediaAssetId])
  @@index([schoolId])
  @@index([schoolId, questionRevisionId])
  @@map("question_media")
}

/// ADR-0001 §3 — first-class, scoped to (school, subject); resolves audit
/// finding A-16 (06 §31 had explicitly deferred this). `subtopic` is a
/// nullable self-reference (a subtopic is just a Topic whose parentTopicId
/// points at another Topic). Case-insensitive uniqueness within
/// (school, subject, parent) is a hand-written functional unique index in
/// this migration's raw SQL (Prisma's DSL can't express lower()/COALESCE
/// expressions) — not citext (no extension precedent anywhere in this
/// codebase) and not application-layer-only (a bare findOrCreate without a
/// DB constraint races under concurrent rows resolving the same brand-new
/// topic name simultaneously, e.g. two import rows in the same batch).
model Topic {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  subjectId     String   @map("subject_id") @db.Uuid
  parentTopicId String?  @map("parent_topic_id") @db.Uuid
  name          String   @db.VarChar(128)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject     Subject @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Restrict)
  parentTopic Topic?  @relation("TopicHierarchy", fields: [schoolId, parentTopicId], references: [schoolId, id], onDelete: Restrict)
  subtopics   Topic[] @relation("TopicHierarchy")

  revisionsAsTopic    QuestionRevision[] @relation("RevisionTopic")
  revisionsAsSubtopic QuestionRevision[] @relation("RevisionSubtopic")

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, subjectId])
  @@index([schoolId, parentTopicId])
  // Case-insensitive uniqueness is the hand-written functional index in
  // this migration's raw SQL below — deliberately no @@unique on `name`
  // here, which would be case-SENSITIVE and would contradict it.
  @@map("topics")
}

// ---------------------------------------------------------------------------
// B9 — Question Review & Governance (docs/roadmaps/backend-roadmap.md "B9",
// ADR-0001, ADR-0017). The HOD approve/reject/request-changes workflow B8
// deliberately left unbuilt (see Question's own doc comment).
// ---------------------------------------------------------------------------

/// 07 §7.5's three decisions. REQUEST_CHANGES and REJECTED both write the
/// *same* `QuestionRevisionStatus.REJECTED` value onto the revision (that
/// enum has no fourth value, and B9's roadmap DoD item 4 says
/// request-changes "behaves equivalently [to reject]") — only this field
/// keeps the two distinguishable, for history/audit/notification-copy
/// purposes. QuestionRevisionService.createRevision's existing "may only
/// revise from APPROVED or REJECTED" gate (B8) needs no change: both
/// decisions already leave the revision exactly where that gate expects.
enum QuestionReviewDecision {
  APPROVED
  REJECTED
  REQUEST_CHANGES
}

/// An immutable academic decision (07 §7.5) — one QuestionRevision may
/// accumulate multiple rows over its lifetime (an HOD's decision, and, after
/// a resubmission cycle, another). Never updated or deleted once written —
/// this migration's 4th trigger, unconditional (unlike the 3 B8 triggers,
/// which only guard an APPROVED parent: a QuestionReview row is never
/// legitimately mutated at all, regardless of its parent revision's later
/// status). `createdAt` satisfies the ERD's `reviewed_at` attribute — this
/// row is created at the exact moment of decision, the same convention
/// AuditEvent already uses for its own event timestamp.
model QuestionReview {
  id                   String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId             String                 @map("school_id") @db.Uuid
  questionRevisionId   String                 @map("question_revision_id") @db.Uuid
  /// A snapshot of who decided, at decision time — never re-resolved later.
  /// DoD item 8: changing the HOD leaves prior decisions attributed to the
  /// previous one; this field is what makes that true by construction,
  /// mirroring QuestionRevision.createdByMembershipId's own precedent.
  reviewerMembershipId String                 @map("reviewer_membership_id") @db.Uuid
  decision             QuestionReviewDecision
  /// Mandatory for REJECTED/REQUEST_CHANGES (05 §16.2), optional for
  /// APPROVED (an HOD note) — enforced at the DTO/service layer, matching
  /// this codebase's existing preference for conditional-required
  /// validation there over a conditional SQL CHECK.
  comment              String?
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Restrict: a revision with review history attached must never be
  /// hard-deletable out from under it. In practice this never fires —
  /// QuestionRevisionService.deleteDraft only ever deletes a DRAFT
  /// revision, which (by definition) has never been reviewed yet.
  revision QuestionRevision @relation(fields: [schoolId, questionRevisionId], references: [schoolId, id], onDelete: Restrict)
  /// Restrict: same reasoning as TeacherProfile.authoredQuestions — a
  /// membership with review history attached must remain attributable to
  /// it even after its HODAssignment ends (DoD item 8).
  reviewer SchoolMembership @relation(fields: [schoolId, reviewerMembershipId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId])
  @@index([schoolId, questionRevisionId])
  @@map("question_reviews")
}

// ---------------------------------------------------------------------------
// B11 — Exam Builder & Readiness (docs/roadmaps/backend-roadmap.md "B11",
// ADR-0001, ADR-0002, ADR-0006, ADR-0013, ADR-0029). Purely additive: no
// changes to any table above besides the two small composite-FK-target
// back-relations added when this block was written (SchoolMembership,
// AcademicSession, AcademicTerm, Department, Subject, ClassSubject,
// QuestionRevision all gained a plain back-relation array; AcademicTerm
// additionally gained its first-ever @@unique([schoolId, id]), the same
// "didn't need it until this phase gave it a child" precedent ClassSubject's
// own doc comment already recorded for B6).
//
// Deliberate simplification, documented here rather than only in the
// roadmap: ADR-0013's "all targeted classes share school, session and
// level" rule is enforced at the SERVICE layer (ExamService's
// assertExamClassAgreement), not via a novel multi-column FK scheme or a
// trigger — mirrors HODAssignment's own precedent exactly ("a cross-table
// invariant... enforced at the service layer... this codebase avoids
// triggers" for this class of check). The two things the roadmap actually
// demands at the database-constraint level — the approved-revision-only
// binding rule (DoD item 2) and READY-immutability (DoD item 6) — get real
// triggers below, mirroring B8's existing trigger idiom precisely.
// ---------------------------------------------------------------------------

/// 07 §14's full seven-state lifecycle, carried in full now — mirrors
/// QuestionRevisionStatus.ARCHIVED's own precedent of shipping the complete
/// spec vocabulary even though this phase's own code only ever writes
/// DRAFT/READY/CANCELLED/ARCHIVED. OPEN/CLOSED/COMPLETED are B12/B13's to
/// write; no migration is needed when those phases start using them.
enum ExamStatus {
  DRAFT
  READY
  OPEN
  CLOSED
  COMPLETED
  ARCHIVED
  CANCELLED
}

/// ADR-0006's own required B11 slice: the column + default only.
/// Participant-authorization mechanics (ExamSessionParticipant, the actual
/// bulk-authorize-on-open behaviour) are entirely B12's job.
enum ExamAccessMode {
  OPEN_TO_ELIGIBLE
  EXPLICIT_AUTHORIZATION
}

/// Confirmed product decision (2026-09-03) — one enum, "revisit" folded in,
/// matching 07 §8.1's single navigation_policy attribute literally rather
/// than a second allow_revisit column.
enum ExamNavigationPolicy {
  FREE
  SEQUENTIAL_NO_REVISIT
  SEQUENTIAL_WITH_REVISIT
}

/// 07 §8.1 — exam identity + configuration. `examType` is free text
/// (confirmed product decision, 2026-09-03), mirroring
/// AcademicSession.name/AcademicTerm.name's own precedent rather than a
/// fixed enum — 05 §19.2's examples ("First CA" / "Mock Examination" / ...)
/// are illustrative, not an exhaustive taxonomy, and Nigerian schools vary
/// in naming.
///
/// resultPolicy/resultDetailVisibility are seeded from School's current
/// values at creation (F5/B3 gap-closure — see result-policy.ts's own doc
/// comment: "Seeds Exam.result_policy at exam creation once B11 exists")
/// and freely editable while DRAFT; School.resultPolicyLocked is
/// deliberately NOT enforced here — that governs whether a teacher may
/// override the seeded value, and is explicitly B15's job per that field's
/// own doc comment.
///
/// createdByMembershipId feeds ResourceContext.ownerMembershipId directly —
/// the existing OWNED scope resolver needs zero new code for every
/// TEACHER-reachable action past creation (editDraft/deleteDraft/
/// addQuestions/configure*/publish/archive are all OWNED-graded in the
/// permission table).
model Exam {
  id                String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId          String  @map("school_id") @db.Uuid
  academicSessionId String  @map("academic_session_id") @db.Uuid
  academicTermId    String  @map("academic_term_id") @db.Uuid
  subjectId         String  @map("subject_id") @db.Uuid
  /// Denormalized from Subject.departmentId at creation — never
  /// independently editable. Powers the DEPARTMENT scope resolver's
  /// resource.departmentId directly without an extra join per check.
  departmentId      String? @map("department_id") @db.Uuid

  title    String @db.VarChar(255)
  examType String @map("exam_type") @db.VarChar(64)

  durationSeconds    Int                  @map("duration_seconds")
  attemptLimit       Int                  @default(1) @map("attempt_limit")
  navigationPolicy   ExamNavigationPolicy @default(FREE) @map("navigation_policy")
  randomizeQuestions Boolean              @default(false) @map("randomize_questions")
  randomizeOptions   Boolean              @default(false) @map("randomize_options")

  resultPolicy           ResultPolicy           @map("result_policy")
  resultDetailVisibility ResultDetailVisibility @map("result_detail_visibility")
  accessMode             ExamAccessMode         @default(OPEN_TO_ELIGIBLE) @map("access_mode")

  /// 05 §71 — exactly 3 fixed instruction types, never a 4th; 3 nullable
  /// columns rather than a child table (a Topic-style open list buys
  /// nothing for a fixed, closed set this small).
  generalInstructions    String? @map("general_instructions")
  navigationInstructions String? @map("navigation_instructions")
  submissionInstructions String? @map("submission_instructions")
  /// 05 §22's "accessibility accommodations where applicable" — free text
  /// at exam level. Per-student accommodation grants are explicitly
  /// Candidate/Deferred to B12/B13's ExamSessionParticipant, not built here.
  accommodations         String? @map("accommodations")

  status ExamStatus @default(DRAFT)

  createdByMembershipId   String    @map("created_by_membership_id") @db.Uuid
  cancelledReason         String?   @map("cancelled_reason")
  cancelledAt             DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByMembershipId String?   @map("cancelled_by_membership_id") @db.Uuid
  archivedAt              DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  session         AcademicSession  @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: Restrict)
  term            AcademicTerm     @relation(fields: [schoolId, academicTermId], references: [schoolId, id], onDelete: Restrict)
  subject         Subject          @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Restrict)
  department      Department?      @relation(fields: [schoolId, departmentId], references: [schoolId, id], onDelete: Restrict)
  createdByMember SchoolMembership @relation("ExamCreatedBy", fields: [schoolId, createdByMembershipId], references: [schoolId, id], onDelete: Restrict)

  classes               ExamClass[]
  sections              ExamSection[]
  questions             ExamQuestion[]
  // B12: activation & control — sessions, delegated administrators, and
  // final per-student participation outcomes (written at End Examination).
  examSessions          ExamSession[]
  administrators        ExamAdministrator[]
  participations        ExamParticipation[]
  attemptAuthorizations AttemptAuthorization[]
  // B13: the actual student attempts taken against this exam.
  attempts              ExamAttempt[]
  mediaCiphertexts      ExamMediaCiphertext[]
  // B15: results derived from those attempts, this exam's single
  // publication row (ADR-0010), and any adjustment operations run over it.
  results               Result[]
  resultPublication     ResultPublication?
  adjustmentOperations  ResultAdjustmentOperation[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, academicSessionId])
  @@index([schoolId, academicTermId])
  @@index([schoolId, subjectId])
  @@index([schoolId, departmentId])
  @@index([schoolId, createdByMembershipId])
  @@map("exams")
}

/// ADR-0013: an exam targets one or more classes. FKs to ClassSubject
/// (not directly to ClassGroup) — ClassSubject already encodes
/// class+subject+session+level together (via classGroupSession.level), so
/// one id gives ExamService.assertExamClassAgreement everything it needs to
/// validate school/session/subject/level agreement in one query, with no
/// denormalized columns of its own. "Same level across every targeted
/// class" (ADR-0013) is enforced there, at the service layer, not by schema
/// shape — see this file's B11 header comment above for why.
model ExamClass {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  examId         String   @map("exam_id") @db.Uuid
  classSubjectId String   @map("class_subject_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  exam         Exam         @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: Cascade)
  classSubject ClassSubject @relation(fields: [schoolId, classSubjectId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, examId, classSubjectId])
  @@index([schoolId])
  @@index([schoolId, examId])
  @@index([schoolId, classSubjectId])
  @@map("exam_classes")
}

/// ADR-0029: always exactly one row per exam, created invisibly by
/// ExamService.create() in the same transaction as the exam itself — never
/// user-editable in B11 (no section UI). No `marks` column: always derived
/// (SUM of this section's ExamQuestion.marks), computed in
/// exam-mappers.ts on read, never persisted ("a stored section total that
/// can disagree with its own children is a defect waiting to happen").
/// No `instructions` column — 05 §71 places instructions at the exam level,
/// not per-section. No immutability trigger — nothing in B11 ever UPDATEs
/// this row (no section UI), so a lock trigger here would be dead code.
model ExamSection {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  examId    String   @map("exam_id") @db.Uuid
  title     String   @default("Main Section") @db.VarChar(128)
  sequence  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam      Exam           @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: Cascade)
  questions ExamQuestion[]

  @@unique([schoolId, examId, sequence])
  // Composite-FK target for ExamQuestion.
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, examId])
  @@map("exam_sections")
}

/// 07 §8.3's binding. questionRevisionId points at the SPECIFIC,
/// B8-immutable-once-APPROVED QuestionRevision row — never at
/// Question.currentRevisionId — which is what makes DoD item 8 ("a later
/// revision does not alter the binding") true automatically: currentFor may
/// later repoint to a brand-new revision, but this row's FK target never
/// moves, and the row it points at can never itself change (B8's own
/// question_revisions_immutable_when_approved trigger already forbids any
/// mutation once APPROVED). No new B11 machinery is needed for that
/// guarantee — it falls out of B8's existing design plus this column's
/// choice of FK target.
///
/// Approved-only binding is enforced by this migration's hand-written
/// trigger (DoD item 2 — "even by direct insert"), not only by the service.
/// `marks` is authoritative (ADR-0029): defaulted from
/// QuestionRevision.marks at bind time by the service, freely reweightable
/// while the exam is DRAFT, and locked at READY by this migration's second
/// trigger.
model ExamQuestion {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId           String   @map("school_id") @db.Uuid
  examId             String   @map("exam_id") @db.Uuid
  examSectionId      String   @map("exam_section_id") @db.Uuid
  questionRevisionId String   @map("question_revision_id") @db.Uuid
  sequence           Int
  marks              Int
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam     Exam             @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: Cascade)
  section  ExamSection      @relation(fields: [schoolId, examSectionId], references: [schoolId, id], onDelete: Restrict)
  revision QuestionRevision @relation(fields: [schoolId, questionRevisionId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, examId, questionRevisionId])
  @@unique([schoolId, examSectionId, sequence])
  @@index([schoolId])
  @@index([schoolId, examId])
  @@index([schoolId, questionRevisionId])
  @@map("exam_questions")
}

// ---------------------------------------------------------------------------
// B12 — Exam Activation & Control (docs/roadmaps/backend-roadmap.md "B12",
// ADR-0006, ADR-0009, ADR-0020; ADR-0012/M-15's ExamAdministrator clause).
// Purely additive on top of B11: three plain back-relation arrays added to
// Exam, one each to StudentProfile (two) and SchoolMembership, the same
// "didn't need it until this phase gave it a child" precedent every prior
// additive phase has recorded.
//
// Deliberate simplification, documented here rather than only in the
// roadmap: every "who performed this action" column below
// (openedByMembershipId, closedByMembershipId, authorizedByMembershipId,
// revokedByMembershipId, markedByMembershipId, assignedByMembershipId) is a
// bare UUID with no Prisma @relation — mirrors Exam.cancelledByMembershipId's
// own B11 precedent exactly (a denormalized actor+timestamp pair kept on the
// row for cheap display, not a referential-integrity-bearing FK; the actual
// audit trail of record is AuditEvent). Only the row's actual *subject* gets
// a real relation: ExamSessionParticipant/ExamParticipation.studentProfileId
// (matching StudentEnrollment's own studentProfileId convention, not a
// membershipId — a student is referenced via StudentProfile throughout this
// schema) and ExamAdministrator.membershipId (the delegate being granted
// authority, mirroring HODAssignment.membershipId's real-relation precedent).
// ExamParticipation.examSessionId is likewise a bare, unrelated UUID — which
// session a student was authorized under at the time they were marked absent
// is reporting metadata only, never a cascade/integrity concern.
// ---------------------------------------------------------------------------

/// 06 §41's own small, closed reporting taxonomy — confirmed product
/// decision (2026-09-04) to include now even though no B12 logic branches
/// on it, since retrofitting it once B16 (makeup) wants to tag sessions
/// would mean a migration touching a table already full of live rows.
enum ExamSessionType {
  STANDARD
  BATCH
  MAKEUP
  SPECIAL
}

/// No READY — a session is born OPEN; per the roadmap's own endpoint-1
/// wording, creating a session IS opening it. CANCELLED is shipped for
/// 07 §15 vocabulary fidelity even though no B12 endpoint reaches it,
/// mirroring ExamStatus.ARCHIVED's own "shipped before exercised" precedent
/// from B11.
enum ExamSessionStatus {
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

/// D-07: deliberately restricted to authorization semantics only — a
/// completed attempt moves to ExamParticipation, not a third value here.
enum ExamSessionParticipantStatus {
  AUTHORIZED
  REVOKED
}

/// A session-scoped participation record. Cross-session reporting derives a
/// student's exam-level outcome from these durable records and attempts.
enum ExamParticipationStatus {
  PENDING
  ATTENDED
  ABSENT
  EXCUSED
}

enum AttemptAuthorizationType {
  MAKEUP
  RETRY
  SPECIAL
}

enum AttemptAuthorizationStatus {
  AUTHORIZED
  USED
  REVOKED
  EXPIRED
}

enum ExamAdministratorStatus {
  ACTIVE
  REVOKED
}

/// 07 §8.4 — "a physical/operational sitting of an exam, not a different
/// examination" (06 §40). Multiple sessions may be OPEN simultaneously for
/// one exam (confirmed product decision, 2026-09-04 — parallel labs, 04
/// §27's own Moderator multi-lab note); Exam.status reflects "has any
/// session ever opened / been explicitly closed or completed," never a
/// single session's own state.
model ExamSession {
  id          String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId    String            @map("school_id") @db.Uuid
  examId      String            @map("exam_id") @db.Uuid
  sessionType ExamSessionType   @default(STANDARD) @map("session_type")
  status      ExamSessionStatus @default(OPEN)

  openedAt             DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  openedByMembershipId String    @map("opened_by_membership_id") @db.Uuid
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  closedByMembershipId String?   @map("closed_by_membership_id") @db.Uuid
  reopenedAt           DateTime? @map("reopened_at") @db.Timestamptz(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Restrict, not Cascade: an exam past READY must never be hard-deletable
  // while it has sessions — ExamService.deleteDraft() already only permits
  // DRAFT exams, which structurally can never have one.
  exam                  Exam                     @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: Restrict)
  participants          ExamSessionParticipant[]
  participations        ExamParticipation[]
  // B13: attempts started under this specific session.
  attempts              ExamAttempt[]
  attemptAuthorizations AttemptAuthorization[]

  // Composite-FK target for ExamSessionParticipant.
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, examId])
  // Control Center query: "every OPEN/CLOSED session for this exam."
  @@index([schoolId, examId, status])
  @@map("exam_sessions")
}

/// 07 §8.5 — ADR-0006: participant rows are ALWAYS written, in both
/// OPEN_TO_ELIGIBLE and EXPLICIT_AUTHORIZATION modes, never skipped — this
/// is what keeps 07 §13's ExamSessionParticipant→Attempt 1:0..N cardinality
/// honest and preserves the audit trail of who was allowed to sit when,
/// regardless of access mode.
model ExamSessionParticipant {
  id               String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId         String                       @map("school_id") @db.Uuid
  examSessionId    String                       @map("exam_session_id") @db.Uuid
  studentProfileId String                       @map("student_profile_id") @db.Uuid
  status           ExamSessionParticipantStatus @default(AUTHORIZED)

  authorizedAt             DateTime  @default(now()) @map("authorized_at") @db.Timestamptz(6)
  /// NULL when the bulk OPEN_TO_ELIGIBLE sweep created this row on session
  /// open — no human authorizer; the eligibility predicate itself is the
  /// authority in that case.
  authorizedByMembershipId String?   @map("authorized_by_membership_id") @db.Uuid
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByMembershipId    String?   @map("revoked_by_membership_id") @db.Uuid
  revokedReason            String?   @map("revoked_reason")

  /// B13/X-11: per-student accommodation, resolved and frozen into
  /// ExamAttempt.durationGrantedSeconds at attempt creation
  /// (exam.durationSeconds + extraTimeSeconds). This is the confirmed
  /// resolution of the genuine StudentAssessmentAccommodation (07 §9.7)
  /// gap B11's own comment flagged as "Candidate/Deferred to B12/B13's
  /// ExamSessionParticipant" — no separate approval-workflow entity is
  /// built; this field plus AttemptLifecycleService.start()'s freeze IS
  /// the whole mechanism. Never mutated after the attempt it applied to
  /// has started (freezing happens by read-then-copy, not by reference).
  extraTimeSeconds               Int?      @map("extra_time_seconds")
  extraTimeGrantedByMembershipId String?   @map("extra_time_granted_by_membership_id") @db.Uuid
  extraTimeGrantedAt             DateTime? @map("extra_time_granted_at") @db.Timestamptz(6)

  /// F20 (owner decision 2026-10-03, DoD 3): the second 07 §9.7
  /// accommodation, LARGER_TEXT — staff-granted, never self-selected,
  /// audited like extra time. A display accommodation only (the assessment
  /// itself is unchanged, 03 §77), so it is read live into the attempt
  /// package rather than frozen into the attempt.
  largerText                      Boolean   @default(false) @map("larger_text")
  largerTextGrantedByMembershipId String?   @map("larger_text_granted_by_membership_id") @db.Uuid
  largerTextGrantedAt             DateTime? @map("larger_text_granted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  session        ExamSession    @relation(fields: [schoolId, examSessionId], references: [schoolId, id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [schoolId, studentProfileId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, examSessionId, studentProfileId])
  @@index([schoolId])
  @@index([schoolId, examSessionId])
  // Control Center aggregate: count by status within a session.
  @@index([schoolId, examSessionId, status])
  @@index([schoolId, studentProfileId])
  @@map("exam_session_participants")
}

/// The participation outcome for one authorized session/student pair.
/// Completion creates ABSENT records for unstarted participants; successful
/// attempt creation records ATTENDED for its exact session. This remains
/// distinct from ExamSessionParticipant's authorization bookkeeping.
model ExamParticipation {
  id                   String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId             String                  @map("school_id") @db.Uuid
  examId               String                  @map("exam_id") @db.Uuid
  examSessionId        String                  @map("exam_session_id") @db.Uuid
  studentProfileId     String                  @map("student_profile_id") @db.Uuid
  status               ExamParticipationStatus
  markedAt             DateTime                @default(now()) @map("marked_at") @db.Timestamptz(6)
  markedByMembershipId String                  @map("marked_by_membership_id") @db.Uuid
  reason               String?

  exam           Exam           @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: Restrict)
  examSession    ExamSession    @relation(fields: [schoolId, examSessionId], references: [schoolId, id], onDelete: Restrict)
  studentProfile StudentProfile @relation(fields: [schoolId, studentProfileId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, examSessionId, studentProfileId])
  @@index([schoolId])
  @@index([schoolId, examId])
  @@index([schoolId, examSessionId])
  @@map("exam_participations")
}

/// ADR-0014's single-use, auditable override of the ordinary attempt limit.
/// The target session is created with the authorization so a completed parent
/// exam never needs to be reopened for a makeup or retry.
model AttemptAuthorization {
  id                       String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId                 String                     @map("school_id") @db.Uuid
  examId                   String                     @map("exam_id") @db.Uuid
  examSessionId            String                     @map("exam_session_id") @db.Uuid
  studentProfileId         String                     @map("student_profile_id") @db.Uuid
  type                     AttemptAuthorizationType
  status                   AttemptAuthorizationStatus @default(AUTHORIZED)
  reason                   String
  authorizedByMembershipId String                     @map("authorized_by_membership_id") @db.Uuid
  authorizedAt             DateTime                   @default(now()) @map("authorized_at") @db.Timestamptz(6)
  expiresAt                DateTime?                  @map("expires_at") @db.Timestamptz(6)
  usedAt                   DateTime?                  @map("used_at") @db.Timestamptz(6)
  revokedAt                DateTime?                  @map("revoked_at") @db.Timestamptz(6)
  revokedByMembershipId    String?                    @map("revoked_by_membership_id") @db.Uuid
  revokedReason            String?                    @map("revoked_reason")
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam           Exam           @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: Restrict)
  examSession    ExamSession    @relation(fields: [schoolId, examSessionId], references: [schoolId, id], onDelete: Restrict)
  studentProfile StudentProfile @relation(fields: [schoolId, studentProfileId], references: [schoolId, id], onDelete: Restrict)
  attempt        ExamAttempt?

  @@unique([schoolId, id])
  @@index([schoolId, examId, studentProfileId, status])
  @@index([schoolId, examSessionId])
  @@map("attempt_authorizations")
}

/// ADR-0012/M-15: "own exam" in the permission table means created_by OR an
/// active ExamAdministrator delegate — resolves the documented case of one
/// teacher (Mr Ade) authoring an exam that another (Mrs Bola) actually
/// administers (02 §11), without inventing a permanent Invigilator role
/// (02 §10). No Prisma-level @@unique (mirrors HODAssignment's own
/// precedent of allowing re-delegation after revocation); "at most one
/// ACTIVE delegation per (exam, membership)" is a hand-written partial
/// unique index in this migration's raw SQL instead.
model ExamAdministrator {
  id           String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId     String                  @map("school_id") @db.Uuid
  examId       String                  @map("exam_id") @db.Uuid
  membershipId String                  @map("membership_id") @db.Uuid
  status       ExamAdministratorStatus @default(ACTIVE)

  assignedAt             DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedByMembershipId String    @map("assigned_by_membership_id") @db.Uuid
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(6)

  exam   Exam             @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: Cascade)
  member SchoolMembership @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, examId])
  @@index([schoolId, membershipId])
  @@map("exam_administrators")
}

// ---------------------------------------------------------------------------
// B13 — Attempt Engine (docs/roadmaps/backend-roadmap.md "B13", ADR-0002,
// ADR-0003, ADR-0007, ADR-0008, ADR-0020, ADR-0021). The highest-integrity
// subsystem in the product (AGENTS.md §5) — attempt creation, immutable
// question snapshots, resilient answer persistence, server-authoritative
// throughout. Purely additive on top of B11/B12: three plain back-relation
// arrays added above (Exam.attempts, ExamSession.attempts,
// StudentProfile.examAttempts) and three nullable columns added to the
// already-shipped ExamSessionParticipant (extraTimeSeconds and its
// actor/timestamp pair), the same "didn't need it until this phase gave it
// a child" precedent every prior additive phase has recorded.
//
// Two decisions confirmed with the project owner during planning (not
// guessed, per AGENTS.md §3 — see CLAUDE.md's B13 Change Log entry for the
// full reasoning):
//
// 1. Remote-impersonation signal (carried forward from B12's own planning,
//    which found this gap uncovered anywhere in the spec/ADR corpus): each
//    attempt is bound to a device/session/IP fingerprint at creation
//    (ExamAttempt.startIpAddress/startUserAgent/startDeviceId/
//    startSessionId). A mid-attempt request bearing a materially different
//    fingerprint is recorded as AttemptEventType.BINDING_MISMATCH — a
//    neutral, off-critical-path signal only, extending ADR-0020's already-
//    decided "counts, not judgements" vocabulary. Never an automatic block.
// 2. Accommodations (X-11): StudentAssessmentAccommodation (07 §9.7) as a
//    standalone approval-workflow entity is a genuine, confirmed spec gap
//    with no phase ever scoped to build it — resolved instead by the
//    ExamSessionParticipant.extraTimeSeconds extension above, resolved and
//    frozen into ExamAttempt.durationGrantedSeconds at attempt creation.
//
// Deliberate schema shape decisions, documented here rather than only in
// the plan: AttemptQuestionSnapshot is ADR-0008's one-JSONB-document-per-
// attempt design as its OWN dedicated 1:1 table (not a column on
// ExamAttempt) — every named ERD entity in this schema gets its own table
// even at 1:1 cardinality (ExamSection is the existing precedent), and
// collapsing it onto ExamAttempt would force the row read on every answer
// save and heartbeat to carry a large JSONB blob unnecessarily. The
// duplicate-start partial unique index (this migration's raw SQL) is
// scoped per (school, exam, student) — not per session — because
// Exam.attemptLimit is exam-scoped and B12's confirmed "multiple
// concurrent OPEN sessions per exam" design would otherwise let a student
// authorized under two sessions of the same exam start two attempts at
// once. AttemptAnswerEvent's immutability is an unconditional trigger
// mirroring B9's question_reviews shape, not B10's audit_events grant-
// REVOKE treatment — that table's belt-and-suspenders exists specifically
// because of a second cross-school-reading Postgres role this table has no
// analog of.
// ---------------------------------------------------------------------------

/// 07 §9.1's full six-state vocabulary carried in full. NOT_STARTED is
/// never written — 07 §23: a row is created already IN_PROGRESS — kept
/// only for spec-vocabulary fidelity, mirroring ExamStatus.ARCHIVED's own
/// "shipped before exercised" precedent. IN_PROGRESS is the only state
/// anything transitions FROM (07 §16); SUBMITTED/AUTO_SUBMITTED/
/// INVALIDATED/CANCELLED are all terminal — enforced by this migration's
/// exam_attempts_status_transition_guard trigger, not by the enum alone.
enum AttemptState {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  INVALIDATED
  CANCELLED
}

/// MAKEUP/RETRY/SPECIAL are assigned only by a consumed B16
/// AttemptAuthorization; STANDARD is the ordinary policy-governed path.
enum AttemptType {
  STANDARD
  MAKEUP
  RETRY
  SPECIAL
}

/// Reporting-only (06 §47) — a distinct field from AttemptState, and a
/// distinct table/enum from B12's own ExamParticipationStatus (which lives
/// on ExamParticipation, not ExamAttempt, and only has ABSENT/COMPLETED).
/// Do not conflate the two.
enum AttemptAnswerState {
  UNANSWERED
  ANSWERED
}

/// ADR-0020's five decided types plus BINDING_MISMATCH — the device/
/// session-binding extension confirmed this planning session (no new ADR;
/// see this block's header comment, decision 1).
enum AttemptEventType {
  WINDOW_BLUR
  FULLSCREEN_EXIT
  TAB_HIDDEN
  RECONNECTED
  RESUMED
  BINDING_MISMATCH
}

/// 07 §9.1/§23 — the actual student execution of an exam, distinct from
/// ExamSessionParticipant (B12, authorization-only bookkeeping). Every
/// parent FK is Restrict: an attempt is the most evidentiary row in the
/// system and must never be cascade-deleted out from under its parent
/// exam/session/student. studentProfileId (not membershipId) matches
/// ExamSessionParticipant's own convention — students are referenced via
/// StudentProfile throughout this schema.
model ExamAttempt {
  id               String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId         String @map("school_id") @db.Uuid
  examId           String @map("exam_id") @db.Uuid
  examSessionId    String @map("exam_session_id") @db.Uuid
  studentProfileId String @map("student_profile_id") @db.Uuid

  attemptNumber          Int          @map("attempt_number")
  attemptType            AttemptType  @default(STANDARD) @map("attempt_type")
  state                  AttemptState @default(IN_PROGRESS)
  attemptAuthorizationId String?      @map("attempt_authorization_id") @db.Uuid

  startedAt              DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  /// Frozen at creation from Exam.durationSeconds +
  /// (ExamSessionParticipant.extraTimeSeconds ?? 0) — never re-read or
  /// re-derived afterward (07 §42 invariant 7: attempt duration cannot be
  /// extended by reconnecting, and this schema gives no ordinary write
  /// path back to this column at all after INSERT).
  durationGrantedSeconds Int       @map("duration_granted_seconds")
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  submittedAt            DateTime? @map("submitted_at") @db.Timestamptz(6)

  invalidationReason        String?   @map("invalidation_reason")
  invalidatedAt             DateTime? @map("invalidated_at") @db.Timestamptz(6)
  /// Bare UUID, no relation — mirrors Exam.cancelledByMembershipId's own
  /// B11 precedent (denormalized actor+timestamp for cheap display; the
  /// real audit trail of record is AuditEvent). Written only by B16's
  /// examAdmin.invalidateAttempt workflow.
  invalidatedByMembershipId String?   @map("invalidated_by_membership_id") @db.Uuid

  /// ADR-0020: updated by answer saves (via a separate, lightweight,
  /// fire-and-forget path — NEVER inside the answer-save transaction, per
  /// R-03) and by the heartbeat endpoint. "Disconnected" is derived by
  /// staleness threshold, not stored as a boolean.
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  /// Decision 1 (confirmed this planning session): device/session binding
  /// captured at creation. Not new fingerprinting — the same signal
  /// Session.ipAddress/Session.userAgent already capture at login (B1),
  /// captured again at attempt start. startDeviceId is nullable: a client
  /// that never sends X-Device-Id degrades to IP+session-only comparison,
  /// never blocks the attempt. startSessionId is the Session.id that
  /// authenticated the request which created this attempt.
  startIpAddress String? @map("start_ip_address") @db.VarChar(64)
  startUserAgent String? @map("start_user_agent")
  startDeviceId  String? @map("start_device_id") @db.Uuid
  startSessionId String? @map("start_session_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam                 Exam                     @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: Restrict)
  examSession          ExamSession              @relation(fields: [schoolId, examSessionId], references: [schoolId, id], onDelete: Restrict)
  studentProfile       StudentProfile           @relation(fields: [schoolId, studentProfileId], references: [schoolId, id], onDelete: Restrict)
  attemptAuthorization AttemptAuthorization?    @relation(fields: [schoolId, attemptAuthorizationId], references: [schoolId, id], onDelete: Restrict)
  snapshot             AttemptQuestionSnapshot?
  answers              AttemptAnswer[]
  answerEvents         AttemptAnswerEvent[]
  events               AttemptEvent[]
  questionResults      AttemptQuestionResult[]
  /// B15: the finalised academic record derived from this attempt. Strictly
  /// 1:1 (07 §13) — a result cannot exist without an attempt.
  result               Result?

  // Composite-FK target for every child table below.
  @@unique([schoolId, id])
  @@unique([schoolId, attemptAuthorizationId])
  @@unique([schoolId, examId, studentProfileId, attemptNumber])
  @@index([schoolId])
  @@index([schoolId, examId])
  @@index([schoolId, examSessionId])
  // Control Center aggregate + live-attempts query.
  @@index([schoolId, examId, state])
  @@index([schoolId, examId, studentProfileId, state])
  @@index([schoolId, studentProfileId])
  @@map("exam_attempts")
}

/// ADR-0008: one JSONB document per attempt (not per-question rows) — see
/// this block's header comment for why this is its own table rather than a
/// column on ExamAttempt. Both question order and option order are
/// materialised into `document` at attempt start and never recomputed at
/// read time (a refresh must be byte-identical). `document`'s shape is
/// AttemptSnapshotDocumentV1 (apps/api/src/modules/execution/
/// attempt-snapshot.types.ts) — not enforced by Postgres beyond `jsonb`,
/// matching this codebase's established "cast, don't validate via a
/// library" JSON convention (ImportRow.rawData, AuditEvent.metadata).
/// Immutable once written — enforced unconditionally by this migration's
/// attempt_question_snapshots_immutable trigger (ADR-0008: "the document
/// is immutable once written"). The client-facing projection strips
/// `document.questions[].options[].correctFlag` entirely — see
/// attempt-snapshot-projection.mapper.ts, the sole permitted place that
/// happens (resolves X-05, release-blocking).
model AttemptQuestionSnapshot {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  attemptId String @map("attempt_id") @db.Uuid

  /// Schema-evolution version for `document` (ADR-0008's required field) —
  /// bump whenever the JSON shape changes; old attempts stay readable by
  /// branching the reader on this field, never by migrating historical
  /// (immutable) documents in place.
  documentVersion Int    @default(1) @map("document_version")
  /// Forensic reproducibility (ADR-0008/A-08) — the seed the
  /// question-order/option-order randomisation was derived from.
  seed            String @db.VarChar(64)
  document        Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attempt ExamAttempt @relation(fields: [schoolId, attemptId], references: [schoolId, id], onDelete: Restrict)

  // The 1:1 relation's defining-side uniqueness — one snapshot per attempt.
  @@unique([schoolId, attemptId])
  @@index([schoolId])
  @@map("attempt_question_snapshots")
}

/// ADR-0007's mutable half — one row per (attempt, question), the hot
/// read/write path, a single indexed upsert (the @@unique below IS that
/// index). examQuestionId references the snapshot document's own question
/// id, not a live FK — no per-question relational table exists under the
/// ADR-0008 one-JSONB-document decision, so it's validated in the service
/// layer against the loaded AttemptQuestionSnapshot.document, not by a
/// database foreign key. Immutable once the parent attempt is no longer
/// IN_PROGRESS — this migration's attempt_answers_immutable_when_attempt_
/// not_in_progress trigger, which is the actual DB-level enforcement of
/// "answers become immutable after submission" (ADR-0007); the service-
/// layer admissibility/ordering checks in front of it are the fast-fail UX
/// layer, matching this codebase's universal service-check +
/// trigger-backstop pattern.
model AttemptAnswer {
  id             String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId       String @map("school_id") @db.Uuid
  attemptId      String @map("attempt_id") @db.Uuid
  examQuestionId String @map("exam_question_id") @db.Uuid

  selectedOptionId String?            @map("selected_option_id") @db.Uuid
  /// Reserved for a future non-option-based answer shape; null for the
  /// SINGLE_CHOICE/TRUE_FALSE question types this codebase supports today.
  answerValue      Json?              @map("answer_value")
  state            AttemptAnswerState @default(UNANSWERED)

  /// Client-assigned, monotonic per (attempt, examQuestionId) — ADR-0007's
  /// ordering protection (resolves X-04). The server rejects any write
  /// whose sequence is <= the stored value; used ONLY for ordering, never
  /// for admissibility (that stays server receipt time, ADR-0003).
  sequenceNumber  Int      @map("sequence_number")
  /// Server receipt time (ADR-0003) — a client-supplied timestamp is never
  /// used to decide admissibility.
  answeredAt      DateTime @default(now()) @map("answered_at") @db.Timestamptz(6)
  lastSavedAt     DateTime @updatedAt @map("last_saved_at") @db.Timestamptz(6)
  /// ADR-0003: true when this write landed inside the post-expiry grace
  /// window — visible in any dispute, never silently indistinguishable
  /// from an on-time answer.
  gradeWindowFlag Boolean  @default(false) @map("grade_window_flag")

  attempt ExamAttempt @relation(fields: [schoolId, attemptId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, attemptId, examQuestionId])
  @@index([schoolId])
  @@index([schoolId, attemptId])
  @@map("attempt_answers")
}

/// ADR-0007's append-only half — written in the SAME transaction as the
/// AttemptAnswer upsert it accompanies (both accepted and rejected writes
/// are captured, the latter via `accepted: false` + `rejectionReason`, for
/// real X-04 dispute-resolution evidence). Immutable unconditionally —
/// this migration's attempt_answer_events_immutable trigger, mirroring B9's
/// question_reviews shape (see this block's header comment for why this
/// table does NOT need B10's audit_events grant-REVOKE treatment).
model AttemptAnswerEvent {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId         String   @map("school_id") @db.Uuid
  attemptId        String   @map("attempt_id") @db.Uuid
  examQuestionId   String   @map("exam_question_id") @db.Uuid
  sequenceNumber   Int      @map("sequence_number")
  selectedOptionId String?  @map("selected_option_id") @db.Uuid
  answerValue      Json?    @map("answer_value")
  receivedAt       DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  /// "online" | "offline-replay" — client-reported, informational only,
  /// never used for admissibility (that's server receipt time + the
  /// grade window regardless of this field's value).
  source           String   @db.VarChar(32)
  gradeWindowFlag  Boolean  @default(false) @map("grade_window_flag")
  accepted         Boolean  @default(true)
  rejectionReason  String?  @map("rejection_reason")

  attempt ExamAttempt @relation(fields: [schoolId, attemptId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId])
  @@index([schoolId, attemptId, examQuestionId])
  @@map("attempt_answer_events")
}

/// ADR-0020: integrity signals and liveness. Written OFF the critical path
/// — never inside the answer-save transaction, never blocking or delaying
/// it. Explicitly client-reported and therefore untrusted; surfaced as
/// "counts, not judgements" — the system never labels a student as
/// cheating. No immutability trigger: unlike AttemptAnswerEvent, nothing
/// here carries dispute-resolution evidentiary weight, and no code path
/// ever mutates a written row — a lock trigger would be dead code,
/// mirroring ExamSection's own "nothing ever UPDATEs this row" precedent.
model AttemptEvent {
  id         String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId   String           @map("school_id") @db.Uuid
  attemptId  String           @map("attempt_id") @db.Uuid
  type       AttemptEventType
  /// Client-reported, ordering-only — never used for admissibility.
  occurredAt DateTime         @map("occurred_at") @db.Timestamptz(6)
  /// Client-reported, untrusted — e.g. fromIp/toIp fields for
  /// BINDING_MISMATCH.
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  attempt ExamAttempt @relation(fields: [schoolId, attemptId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId])
  @@index([schoolId, attemptId])
  // Control Center's "counts, not judgements" aggregate by type.
  @@index([schoolId, attemptId, type])
  @@map("attempt_events")
}

/// B14 (Submission & Marking) — PARTIAL is reserved/unused this phase; every
/// question type this codebase supports today (SINGLE_CHOICE/TRUE_FALSE) is
/// decided purely by whether the selected option's correctFlag is true, so
/// marking never branches on questionType. Kept for spec fidelity (07 §9.4)
/// against a future non-objective question type, mirroring this schema's
/// established "ship the full vocabulary, write only what's reachable now"
/// precedent (AttemptState.NOT_STARTED, ExamStatus.OPEN before B12, ...).
enum AttemptQuestionCorrectness {
  CORRECT
  INCORRECT
  UNANSWERED
  PARTIAL
}

/// B14 — one row per (attempt, question), the marking output ADR-0007's own
/// frozen inputs (AttemptQuestionSnapshot.document + the now-immutable
/// AttemptAnswer rows) always resolve to the same way twice, which is what
/// makes an unconditional upsert correct with no ordering guard needed
/// (unlike AttemptAnswer, marking has no sequence-number/replay concept).
/// Deliberately entity-free of `Result` (a confirmed decision this phase's
/// own planning session settled): totals/percentage/counts are computed
/// LIVE by aggregating these rows (`GET /v1/attempts/:id/status`), never
/// persisted as a `Result` row — `Result`/`GradingScale`/publication/
/// adjustment are all B15's job, reading this table as its own marking
/// output ("B15 creates results from marking output" — backend-roadmap.md's
/// own B14 section). maximumMarks is denormalized from the snapshot's own
/// frozen per-question `marks` (ADR-0029) rather than re-joined on every
/// read — the same "copy the frozen value, don't re-derive" precedent as
/// ExamAttempt.durationGrantedSeconds — so GET /status is one indexed
/// aggregate query with no JSONB parsing. No unconditional immutability
/// trigger, unlike AttemptAnswer/AttemptAnswerEvent/AttemptQuestionSnapshot:
/// re-marking is a deliberate, expected overwrite, not an anomaly. This
/// migration's own attempt_question_results_require_finalized_attempt
/// trigger instead blocks writes only WHILE the parent attempt is still
/// IN_PROGRESS — the DB-level backstop for "finalisation must be durable
/// before any downstream marking worker runs," and never blocks for any
/// other reason.
model AttemptQuestionResult {
  id             String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId       String @map("school_id") @db.Uuid
  attemptId      String @map("attempt_id") @db.Uuid
  examQuestionId String @map("exam_question_id") @db.Uuid

  correctness  AttemptQuestionCorrectness
  awardedMarks Int                        @map("awarded_marks")
  maximumMarks Int                        @map("maximum_marks")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempt ExamAttempt @relation(fields: [schoolId, attemptId], references: [schoolId, id], onDelete: Restrict)

  // The upsert target (marking is keyed on exactly this triple) — mirrors
  // AttemptAnswer's identical (schoolId, attemptId, examQuestionId) shape.
  @@unique([schoolId, attemptId, examQuestionId])
  @@index([schoolId])
  @@index([schoolId, attemptId])
  @@index([schoolId, examQuestionId])
  @@map("attempt_question_results")
}

// ---------------------------------------------------------------------------
// B15 — Results & Publication (ADR-0010, ADR-0018, ADR-0025)
// ---------------------------------------------------------------------------

/// ADR-0010 reduces 07 §10.1's literal enum to the MARKING lifecycle only:
/// PUBLISHED/UNPUBLISHED are removed (visibility lives in ResultPublication,
/// one row per exam), and VOIDED is added by ADR-0025. Keeping publication
/// here would conflate two orthogonal axes — an ADJUSTED-and-PUBLISHED result
/// would be unrepresentable, and adjusting a published result would silently
/// unpublish it (audit C-05).
enum ResultState {
  PROCESSING
  FINAL
  ADJUSTED
  VOIDED
}

enum ResultPublicationStatus {
  PUBLISHED
  UNPUBLISHED
}

/// 07 §10.2's five types, verbatim. VOID_QUESTION excludes one question from
/// both earned and maximum marks; AWARD_MARK/DEDUCT_MARK shift earned marks
/// by a delta; RECALCULATE re-derives from AttemptQuestionResult (repair);
/// MANUAL_OVERRIDE sets earned marks outright and is the most restricted
/// operation in the product (School Admin only, mandatory reason).
enum ResultAdjustmentType {
  VOID_QUESTION
  AWARD_MARK
  DEDUCT_MARK
  RECALCULATE
  MANUAL_OVERRIDE
}

enum ResultAdjustmentOperationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// 07 §10.1 / 06 §54. Derived from marking, never manually entered (06 §56):
/// there is no endpoint anywhere that writes earnedMarks outside the
/// ResultAdjustment workflow (B15 DoD item 10).
///
/// Created in PROCESSING by whichever path finalises the attempt, then moved
/// to FINAL by the marking worker once every question is marked (07 §29) —
/// so a result left in PROCESSING is exactly B19's "pending results" signal,
/// and a marking job that was never enqueued (B14's own documented Redis-
/// outage residual risk) leaves a visible row rather than nothing at all.
///
/// grade/gradingScaleVersionId are frozen at finalisation (ADR-0018): editing
/// a scale later creates a new version and never touches an existing result.
/// totalMarks/earnedMarks/percentage stay authoritative regardless of whether
/// any grading scale is configured at all (05 §46, DoD item 9).
///
/// VOIDED (ADR-0025) is reached only when the underlying attempt becomes
/// INVALIDATED or CANCELLED — B16 wires that event; B15 owns the state, the
/// transition and the shared exclusion filter. The invalidation reason is NOT
/// duplicated here: it is read from the attempt's own invalidationReason, so
/// there is one source of truth for it.
model Result {
  id               String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId         String @map("school_id") @db.Uuid
  attemptId        String @map("attempt_id") @db.Uuid
  examId           String @map("exam_id") @db.Uuid
  studentProfileId String @map("student_profile_id") @db.Uuid

  state ResultState @default(PROCESSING)

  totalMarks      Int     @map("total_marks")
  earnedMarks     Int     @map("earned_marks")
  /// Percentage to two decimal places, computed by @atlas/domain's
  /// computeResultTotals — the same function AttemptStatusService uses, so
  /// the persisted result and the live attempt-status aggregate can never
  /// disagree.
  percentage      Decimal @map("percentage") @db.Decimal(5, 2)
  correctCount    Int     @map("correct_count")
  incorrectCount  Int     @map("incorrect_count")
  unansweredCount Int     @map("unanswered_count")
  partialCount    Int     @map("partial_count")

  grade                 String? @db.VarChar(16)
  gradingScaleVersionId String? @map("grading_scale_version_id") @db.Uuid

  finalizedAt DateTime? @map("finalized_at") @db.Timestamptz(6)

  /// ADR-0010's individual-withholding axis: a disputed result among 40 is
  /// held back by this flag through an audited action with a reason, rather
  /// than by fragmenting per-exam publication.
  withheld               Boolean   @default(false)
  withheldReason         String?   @map("withheld_reason")
  withheldByMembershipId String?   @map("withheld_by_membership_id") @db.Uuid
  withheldAt             DateTime? @map("withheld_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempt             ExamAttempt          @relation(fields: [schoolId, attemptId], references: [schoolId, id], onDelete: Restrict)
  exam                Exam                 @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: Restrict)
  studentProfile      StudentProfile       @relation(fields: [schoolId, studentProfileId], references: [schoolId, id], onDelete: Restrict)
  gradingScaleVersion GradingScaleVersion? @relation(fields: [schoolId, gradingScaleVersionId], references: [schoolId, id], onDelete: Restrict)

  adjustments ResultAdjustment[]

  /// 07 §13's strict 1:1 — "a result cannot exist without an attempt." The
  /// FK above makes the second half structural; this makes the first.
  @@unique([schoolId, attemptId])
  // Composite-FK target for ResultAdjustment.
  @@unique([schoolId, id])
  @@index([schoolId])
  // The staff results list (GET /v1/exams/:id/results) and every aggregate,
  // both of which filter on state to exclude VOIDED (ADR-0025).
  @@index([schoolId, examId, state])
  @@index([schoolId, state, finalizedAt])
  // The student results list — own results, newest first.
  @@index([schoolId, studentProfileId, state])
  @@map("results")
}

/// 07 §10.3 / 06 §59, scoped PER EXAM by ADR-0010 (resolving audit A-09):
/// publish and unpublish are single-row operations, and "is this exam
/// published?" is a single-row answer.
///
/// adjustmentInProgress is ADR-0025's "no partially-regraded cohort is ever
/// visible" hold. The confirmed choice between the ADR's two alternatives is
/// to MARK results under adjustment rather than auto-unpublish them: the
/// publication state is preserved, so completing an adjustment does not
/// depend on someone remembering to re-publish, and a crashed operation
/// cannot silently strand a previously-published cohort.
model ResultPublication {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  examId   String @map("exam_id") @db.Uuid

  status ResultPublicationStatus @default(UNPUBLISHED)

  publishedByMembershipId   String?   @map("published_by_membership_id") @db.Uuid
  publishedAt               DateTime? @map("published_at") @db.Timestamptz(6)
  unpublishedByMembershipId String?   @map("unpublished_by_membership_id") @db.Uuid
  unpublishedAt             DateTime? @map("unpublished_at") @db.Timestamptz(6)

  adjustmentInProgress Boolean @default(false) @map("adjustment_in_progress")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam Exam @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, examId])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("result_publications")
}

/// ADR-0025's parent half: a bulk adjustment is a SINGLE parent operation
/// with per-result child records, processed idempotently and resumably. A
/// single-result adjustment is the same shape with exactly one child, so
/// bulk and single share one code path, one audit shape and one replay
/// guarantee.
///
/// processingClaimedAt is the atomically-claimed, per-chunk-refreshed lease
/// B7's import-commit already established in this codebase — it stops two
/// overlapping executions (a BullMQ stalled-lock redelivery) from both
/// processing the same children.
model ResultAdjustmentOperation {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  examId   String @map("exam_id") @db.Uuid

  type   ResultAdjustmentType
  status ResultAdjustmentOperationStatus @default(PENDING)
  reason String

  /// VOID_QUESTION only — the ExamQuestion excluded from every affected
  /// result. A bare UUID with no FK, mirroring this schema's established
  /// convention for a selector/actor column (ExamQuestion carries no
  /// (school_id, id) composite-FK target, and adding one would mean
  /// altering an already-shipped B11 table for a validation the service
  /// layer performs anyway).
  targetExamQuestionId String? @map("target_exam_question_id") @db.Uuid
  /// AWARD_MARK/DEDUCT_MARK: the magnitude, always positive. The type
  /// carries the direction.
  markDelta            Int?    @map("mark_delta")
  /// MANUAL_OVERRIDE only — the single result being overridden.
  targetResultId       String? @map("target_result_id") @db.Uuid
  /// MANUAL_OVERRIDE only — the earned-marks value being set outright.
  overrideEarnedMarks  Int?    @map("override_earned_marks")

  totalCount   Int @default(0) @map("total_count")
  appliedCount Int @default(0) @map("applied_count")
  failedCount  Int @default(0) @map("failed_count")

  failureReason String? @map("failure_reason")

  createdByMembershipId String    @map("created_by_membership_id") @db.Uuid
  processingClaimedAt   DateTime? @map("processing_claimed_at") @db.Timestamptz(6)
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam     Exam               @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: Restrict)
  children ResultAdjustment[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, examId])
  @@map("result_adjustment_operations")
}

/// 07 §10.2's entity — ADR-0025's child half, and the append-only history
/// that makes "replaying adjustments in order reproduces the original
/// result" (07 §38, DoD item 12) true by construction: each row carries the
/// complete numeric before/after snapshot, so the original is recoverable by
/// walking backwards regardless of how many adjustments followed.
///
/// "A result adjustment is an event, not a silent overwrite" (07 §10.2) —
/// enforced by an unconditional immutability trigger, not by convention.
model ResultAdjustment {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId    String @map("school_id") @db.Uuid
  operationId String @map("operation_id") @db.Uuid
  resultId    String @map("result_id") @db.Uuid

  adjustmentType ResultAdjustmentType @map("adjustment_type")

  /// Numeric snapshots of the result immediately before and after this
  /// adjustment — totalMarks, earnedMarks, percentage, correctCount,
  /// incorrectCount, unansweredCount, partialCount and grade. Written as a
  /// flat JSON object; deliberately described without literal braces here,
  /// since scripts/lint-schema-tenancy.mjs matches model bodies by brace
  /// counting and a brace in a doc comment truncates its parse (the same
  /// trap B7's ImportRow.errors comment already documents).
  oldValue Json @map("old_value")
  newValue Json @map("new_value")

  reason                   String
  authorizedByMembershipId String @map("authorized_by_membership_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  operation ResultAdjustmentOperation @relation(fields: [schoolId, operationId], references: [schoolId, id], onDelete: Restrict)
  result    Result                    @relation(fields: [schoolId, resultId], references: [schoolId, id], onDelete: Restrict)

  /// The idempotency key: a resumed or redelivered run skips any child that
  /// already exists rather than applying the same adjustment twice.
  @@unique([schoolId, operationId, resultId])
  @@index([schoolId])
  @@index([schoolId, resultId])
  @@map("result_adjustments")
}

/// ADR-0018 (resolving audit M-06, a gap 07 leaves entirely — there is no
/// GradingScale anywhere in the ERD). School-owned, with OPTIONAL level
/// scoping so a JSS scale may differ from an SS scale without forcing either.
/// A row with level = NULL is the school-wide default.
///
/// Parent + versioned child, deliberately the same shape as B8's Question/
/// QuestionRevision rather than a new pattern: editing a scale creates a new
/// version and bands are never mutated in place, which is what keeps a
/// historical result's grade stable and explainable (07 §42 invariant 13).
model GradingScale {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid

  name             String      @db.VarChar(120)
  level            ClassLevel?
  currentVersionId String?     @unique @map("current_version_id") @db.Uuid
  archivedAt       DateTime?   @map("archived_at") @db.Timestamptz(6)

  createdByMembershipId String? @map("created_by_membership_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  currentVersion GradingScaleVersion?  @relation("GradingScaleCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       GradingScaleVersion[] @relation("GradingScaleVersions")

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, level])
  @@map("grading_scales")
}

model GradingScaleVersion {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  scaleId  String @map("scale_id") @db.Uuid

  versionNumber         Int     @map("version_number")
  createdByMembershipId String? @map("created_by_membership_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  scale      GradingScale       @relation("GradingScaleVersions", fields: [schoolId, scaleId], references: [schoolId, id], onDelete: Cascade)
  currentFor GradingScale?      @relation("GradingScaleCurrentVersion")
  bands      GradingScaleBand[]
  /// Results whose grade was frozen against this exact version. The FK is
  /// Restrict, so a version that has ever graded a result can never be
  /// deleted out from under it.
  results    Result[]

  @@unique([schoolId, scaleId, versionNumber])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("grading_scale_versions")
}

/// ADR-0018: "Bands are ordered percentage ranges with a label." Inclusive
/// on both ends; the service layer validates that a version's bands neither
/// overlap nor leave a gap across 0–100.
///
/// isPassing has no source in any specification — "pass rate" is a required
/// analytics metric (05 §55.1, 01 §44) with no threshold defined anywhere.
/// Confirmed with the project owner: carry it per band, so the pass concept
/// derives from the same frozen scale version that produced the grade rather
/// than from a second, independently-driftable source of truth.
model GradingScaleBand {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  versionId String @map("version_id") @db.Uuid

  label         String  @db.VarChar(16)
  minPercentage Decimal @map("min_percentage") @db.Decimal(5, 2)
  maxPercentage Decimal @map("max_percentage") @db.Decimal(5, 2)
  isPassing     Boolean @default(false) @map("is_passing")
  sortOrder     Int     @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  version GradingScaleVersion @relation(fields: [schoolId, versionId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, versionId, sortOrder])
  @@index([schoolId])
  @@index([schoolId, versionId])
  @@map("grading_scale_bands")
}

// ---------------------------------------------------------------------------
// Reporting & Export domain (05 §54, 02, ADR-0030) — B18.
// ---------------------------------------------------------------------------

enum ExportJobType {
  EXAM_RESULTS
  STUDENTS
  TEACHERS
  CLASSES
  QUESTION_BANK
  PARTICIPATION
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

/// B18 — Reporting & Export (05 §54, 08 §14, §15, ADR-0030). Tracks asynchronous
/// export jobs generating scoped CSV deliverables stored in object storage.
model ExportJob {
  id       String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId String          @map("school_id") @db.Uuid
  type     ExportJobType
  status   ExportJobStatus @default(PENDING)

  requesterUserId       String  @map("requester_user_id") @db.Uuid
  requesterRole         Role    @map("requester_role")
  requesterMembershipId String? @map("requester_membership_id") @db.Uuid

  /// Immutable, validated request parameters (exam, class, department and/or
  /// academic context).  Kept with the job so a retry cannot silently widen it.
  scope Json

  /// Stored S3 key: schools/SCHOOL_ID/reports/exports/JOB_ID/FILENAME
  storageKey       String? @map("storage_key") @db.VarChar(512)
  originalFilename String? @map("original_filename") @db.VarChar(255)
  contentType      String? @map("content_type") @db.VarChar(127)
  sizeBytes        Int?    @map("size_bytes")
  rowCount         Int     @default(0) @map("row_count")
  failureReason    String? @map("failure_reason")

  /// Rotated, hashed capability for a short-lived authenticated download.
  /// The requester identity is still checked before the object is read.
  downloadTokenHash      String?   @map("download_token_hash") @db.VarChar(64)
  downloadTokenExpiresAt DateTime? @map("download_token_expires_at") @db.Timestamptz(6)

  /// Expiry for download link and artefact cleanup (default 24h)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, requesterUserId])
  @@map("export_jobs")
}

/// F20 — encrypted media pre-cache (owner decision 2026-10-03; ADR-0021
/// amendment). One row per (exam, media asset): an AES-256-GCM copy of the
/// asset under a key derived per exam (HKDF of MEDIA_PRECACHE_SECRET, never
/// stored), written to object storage so a lab can download a paper's media
/// before the exam window while no student can view it before their own
/// Start — the key arrives only in the attempt package. Operational data:
/// purgeable by the retention sweep once the exam is over (the plaintext
/// MediaAsset is the record of what was shown).
model ExamMediaCiphertext {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  examId       String   @map("exam_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  storageKey   String   @unique @map("storage_key") @db.VarChar(512)
  /// Ciphertext size (12-byte IV + body + 16-byte tag) — the client's
  /// storage pre-flight sums these.
  byteSize     Int      @map("byte_size")
  /// Hex SHA-256 of the ciphertext object — the client verifies its download.
  sha256       String   @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  exam       Exam       @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [schoolId, mediaAssetId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, examId, mediaAssetId])
  @@index([schoolId])
  @@index([schoolId, examId])
  @@map("exam_media_ciphertexts")
}
