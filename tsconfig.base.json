{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "incremental": true,
    // Without this, TS's default incremental-build cache location is next
    // to tsconfig.json — outside outDir/dist. nest-cli.json's
    // `deleteOutDir: true` (apps/api) then wipes dist without touching
    // that cache, so a rebuild sees "nothing changed" and silently writes
    // no output at all. Keeping it inside dist means deleting dist always
    // invalidates the cache too.
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "exclude": ["node_modules", "dist", ".next", "generated"]
}
