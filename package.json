{
  "name": "project-atlas",
  "private": true,
  "version": "0.0.0",
  "description": "ExamKeep \u2014 multi-tenant CBT platform (monorepo root).",
  "engines": {
    "node": ">=22.18.0 <25.0.0"
  },
  "packageManager": "pnpm@11.27.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint && pnpm lint:schema && pnpm lint:migrations",
    "lint:fix": "turbo run lint -- --fix",
    "lint:schema": "node scripts/lint-schema-tenancy.mjs",
    "lint:migrations": "node --test scripts/lint-migrations.test.mjs && node scripts/lint-migrations.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1 --filter=!@atlas/tests-cross-cutting && turbo run test:integration --filter=@atlas/tests-cross-cutting",
    "test:security": "turbo run test:security",
    "audit:deps": "pnpm audit --prod --audit-level high",
    "generate": "pnpm --filter @atlas/api run openapi:emit && pnpm --filter @atlas/contracts run generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @atlas/db run generate",
    "db:migrate": "pnpm --filter @atlas/db run migrate:dev",
    "db:migrate:deploy": "pnpm --filter @atlas/db run migrate:deploy",
    "db:seed": "pnpm --filter @atlas/db run seed",
    "spike": "pnpm --filter @atlas/api run spike",
    "generate:permission-table-doc": "pnpm --filter @atlas/domain run build && node scripts/generate-permission-table-doc.mjs",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.14.0",
    "lint-staged": "^16.2.4",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
